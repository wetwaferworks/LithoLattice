double nowSeconds() { return emscripten_get_now() / 1000.0; }

/// State shared between the DOM callbacks, the input backend's poll(), and
/// the Window (cursor capture + focus). Callbacks are registered with
/// CALLING_THREAD delivery, so they run on this (proxied) pthread — the same
/// thread that polls; the mutex is belt-and-braces, not load-bearing.
struct InputSharedState {
  std::mutex mutex;
  std::vector<InputEvent> queue;
  std::atomic<bool> focused{true};
  std::atomic<bool> pointerLocked{false};
  std::atomic<bool> captureWanted{false};
  std::atomic<int> focusLostEdges{0};
  std::atomic<int> focusGainedEdges{0};
  std::atomic<double> lastLockRequest{-1.0};
  bool debugEcho = false;       // ?debuginput=1 in the page URL
  int moveEchoBudget = 0;       // rate-limited mousemove echo (debug only)
  bool haveCursor = false;      // last canvas-relative cursor position valid
  double lastX = 0, lastY = 0;  // CSS pixels, canvas-relative

  void push(const InputEvent& e) {
    std::lock_guard lock(mutex);
    queue.push_back(e);
  }
};

/// DOM KeyboardEvent.code (physical key position, layout independent — the
/// same basis GLFW key codes use) -> litholattice Key.
Key keyFromDomCode(const char* code) {
  const std::string_view c = code;
  if (c.size() == 4 && c.starts_with("Key")) {
    const char l = c[3];
    if (l >= 'A' && l <= 'Z') return Key(int(Key::A) + (l - 'A'));
  }
  if (c.size() == 6 && c.starts_with("Digit")) {
    const char d = c[5];
    if (d >= '0' && d <= '9') return Key(int(Key::Num0) + (d - '0'));
  }
  if (c.size() == 7 && c.starts_with("Numpad")) {
    const char d = c[6];
    if (d >= '0' && d <= '9') return Key(int(Key::Num0) + (d - '0'));
  }
  if (c == "Space") return Key::Space;
  if (c == "Enter" || c == "NumpadEnter") return Key::Enter;
  if (c == "Escape") return Key::Escape;
  if (c == "Backspace") return Key::Backspace;
  if (c == "Tab") return Key::Tab;
  if (c == "ShiftLeft") return Key::LeftShift;
  if (c == "ShiftRight") return Key::RightShift;
  if (c == "ControlLeft") return Key::LeftCtrl;
  if (c == "ControlRight") return Key::RightCtrl;
  if (c == "AltLeft") return Key::LeftAlt;
  if (c == "AltRight") return Key::RightAlt;
  if (c == "ArrowUp") return Key::Up;
  if (c == "ArrowDown") return Key::Down;
  if (c == "ArrowLeft") return Key::Left;
  if (c == "ArrowRight") return Key::Right;
  if (c == "Insert") return Key::Insert;
  if (c == "Delete") return Key::Delete;
  if (c == "Home") return Key::Home;
  if (c == "End") return Key::End;
  if (c == "PageUp") return Key::PageUp;
  if (c == "PageDown") return Key::PageDown;
  if (c == "Minus") return Key::Minus;
  if (c == "Equal") return Key::Equal;
  if (c == "BracketLeft") return Key::LeftBracket;
  if (c == "BracketRight") return Key::RightBracket;
  if (c == "Semicolon") return Key::Semicolon;
  if (c == "Quote") return Key::Apostrophe;
  if (c == "Comma") return Key::Comma;
  if (c == "Period") return Key::Period;
  if (c == "Slash") return Key::Slash;
  if (c == "Backslash" || c == "IntlBackslash") return Key::Backslash;
  if (c == "Backquote") return Key::GraveAccent;
  if (c.size() >= 2 && c[0] == 'F') {  // F1..F12
    int n = 0;
    bool digits = true;
    for (size_t i = 1; i < c.size(); ++i) {
      if (c[i] < '0' || c[i] > '9') { digits = false; break; }
      n = n * 10 + (c[i] - '0');
    }
    if (digits && n >= 1 && n <= 12) return Key(int(Key::F1) + (n - 1));
  }
  return Key::Unknown;
}

std::optional<MouseButton> buttonFromDom(unsigned short b) {
  switch (b) {
    case 0: return MouseButton::Left;
    case 1: return MouseButton::Middle;
    case 2: return MouseButton::Right;
    case 3: return MouseButton::Back;
    case 4: return MouseButton::Forward;
    default: return std::nullopt;
  }
}

/// First UTF-8 code point of a DOM `key` string, or 0 when it is a named
/// (multi-character) key rather than text.
char32_t firstCodePoint(const char* s) {
  const auto* u = reinterpret_cast<const unsigned char*>(s);
  if (!u[0]) return 0;
  if (u[0] < 0x80) return u[0];
  if ((u[0] & 0xE0) == 0xC0 && u[1]) return char32_t(((u[0] & 0x1F) << 6) | (u[1] & 0x3F));
  if ((u[0] & 0xF0) == 0xE0 && u[1] && u[2]) return char32_t(((u[0] & 0x0F) << 12) | ((u[1] & 0x3F) << 6) | (u[2] & 0x3F));
  if ((u[0] & 0xF8) == 0xF0 && u[1] && u[2] && u[3])
    return char32_t(((u[0] & 0x07) << 18) | ((u[1] & 0x3F) << 12) | ((u[2] & 0x3F) << 6) | (u[3] & 0x3F));
  return 0;
}

bool onKeyDown(int, const EmscriptenKeyboardEvent* e, void* user) {
  auto* st = static_cast<InputSharedState*>(user);
  const Key k = keyFromDomCode(e->code);
  const double t = nowSeconds();
  if (k != Key::Unknown) {
    st->push(InputEvent::key(e->repeat ? InputEvent::Type::KeyRepeat : InputEvent::Type::KeyDown, k, t));
    if (st->debugEcho) {
      const std::string name(inputName(k));
      logInfo("input> KeyDown %s (code %s%s)", name.c_str(), e->code, e->repeat ? ", repeat" : "");
    }
  } else if (st->debugEcho) {
    logInfo("input> KeyDown unmapped (code %s)", e->code);
  }
  // Text: the DOM `key` string is the post-layout character (GLFW's char
  // callback equivalent). Single printable characters only.
  if (!e->ctrlKey && !e->metaKey) {
    const std::string_view kv = e->key;
    if (kv.size() >= 1 && kv.size() <= 4) {
      const char32_t cp = firstCodePoint(e->key);
      if (cp >= 0x20 && cp != 0x7F) st->push(InputEvent::text(cp, t));
    }
  }
  // Consume the keys the browser would otherwise spend on the page itself
  // (scroll, focus escape); never fight the browser's own shortcuts.
  return st->pointerLocked.load() || k == Key::Space || k == Key::Tab || k == Key::Up || k == Key::Down ||
         k == Key::Left || k == Key::Right || k == Key::PageUp || k == Key::PageDown;
}

bool onKeyUp(int, const EmscriptenKeyboardEvent* e, void* user) {
  auto* st = static_cast<InputSharedState*>(user);
  const Key k = keyFromDomCode(e->code);
  if (k != Key::Unknown) {
    st->push(InputEvent::key(InputEvent::Type::KeyUp, k, nowSeconds()));
    if (st->debugEcho) {
      const std::string name(inputName(k));
      logInfo("input> KeyUp %s", name.c_str());
    }
  }
  return false;
}

/// Canvas-relative cursor position (CSS px) -> framebuffer pixels.
void cursorFb(const EmscriptenMouseEvent* e, float& fx, float& fy) {
  double cssW = 0, cssH = 0;
  int fbW = 0, fbH = 0;
  emscripten_get_element_css_size("#canvas", &cssW, &cssH);
  emscripten_get_canvas_element_size("#canvas", &fbW, &fbH);
  fx = float(cssW > 0 ? e->targetX * fbW / cssW : e->targetX);
  fy = float(cssH > 0 ? e->targetY * fbH / cssH : e->targetY);
}

bool onMouseDown(int, const EmscriptenMouseEvent* e, void* user) {
  auto* st = static_cast<InputSharedState*>(user);
  // A click inside the canvas is the engagement gesture pointer lock wants:
  // if the game is asking for the cursor and the lock is not engaged, ask
  // again from inside this handler, where the browser grants it.
  if (st->captureWanted.load() && !st->pointerLocked.load())
    emscripten_request_pointerlock("#canvas", EM_FALSE);
  if (const auto b = buttonFromDom(e->button)) {
    st->push(InputEvent::mouse(InputEvent::Type::MouseDown, *b, nowSeconds()));
    if (st->debugEcho) {
      const std::string name(inputName(*b));
      logInfo("input> MouseDown %s", name.c_str());
    }
  }
  float fx = 0, fy = 0;
  cursorFb(e, fx, fy);
  st->push(InputEvent::cursor(fx, fy, nowSeconds()));
  return true;  // consume: no text selection / drag images off the canvas
}

bool onMouseUp(int, const EmscriptenMouseEvent* e, void* user) {
  auto* st = static_cast<InputSharedState*>(user);
  if (const auto b = buttonFromDom(e->button)) {
    st->push(InputEvent::mouse(InputEvent::Type::MouseUp, *b, nowSeconds()));
    if (st->debugEcho) {
      const std::string name(inputName(*b));
      logInfo("input> MouseUp %s", name.c_str());
    }
  }
  return true;
}

bool onMouseMove(int, const EmscriptenMouseEvent* e, void* user) {
  auto* st = static_cast<InputSharedState*>(user);
  const double t = nowSeconds();
  float dx = 0, dy = 0;
  if (st->pointerLocked.load() && (e->movementX != 0 || e->movementY != 0)) {
    // Locked: the DOM movement is the unbounded delta (position is frozen).
    dx = float(e->movementX);
    dy = float(e->movementY);
    st->haveCursor = false;  // position meaningless while locked
  } else {
    // Unlocked fallback (also the drag-look path when a browser refuses the
    // lock): deltas from successive canvas-relative positions, exactly the
    // GLFW backend's method. Look still turns; it just stops at the edges.
    if (st->haveCursor) {
      dx = float(e->targetX - st->lastX);
      dy = float(e->targetY - st->lastY);
    }
    st->lastX = e->targetX;
    st->lastY = e->targetY;
    st->haveCursor = true;
  }
  if (dx != 0.f || dy != 0.f) {
    st->push(InputEvent::motion(dx, dy, t));
    if (st->debugEcho && st->moveEchoBudget > 0) {
      --st->moveEchoBudget;
      logInfo("input> MouseMove %+.0f %+.0f%s", double(dx), double(dy), st->pointerLocked.load() ? " (locked)" : "");
    }
  }
  if (!st->pointerLocked.load()) {
    float fx = 0, fy = 0;
    cursorFb(e, fx, fy);
    st->push(InputEvent::cursor(fx, fy, t));
  }
  return false;
}

bool onWheel(int, const EmscriptenWheelEvent* e, void* user) {
  auto* st = static_cast<InputSharedState*>(user);
  // DOM: deltaY down is positive; the game's wheel is + = up / away.
  float steps = 0;
  if (e->deltaMode == 0) steps = float(-e->deltaY / 100.0);        // pixels: ~100 px per notch
  else if (e->deltaMode == 1) steps = float(-e->deltaY);           // lines
  else steps = float(-e->deltaY * 5.0);                            // pages
  steps = std::clamp(steps, -8.f, 8.f);
  if (steps != 0.f) {
    st->push(InputEvent::wheel(steps, nowSeconds()));
    if (st->debugEcho) logInfo("input> MouseWheel %+.2f", double(steps));
  }
  return true;  // consume: the page must not scroll under the game
}

bool onPointerLockChange(int, const EmscriptenPointerlockChangeEvent* e, void* user) {
  auto* st = static_cast<InputSharedState*>(user);
  const bool was = st->pointerLocked.exchange(e->isActive != EM_FALSE);
  logInfo("input: pointer lock %s", e->isActive ? "engaged" : "released");
  if (was && !e->isActive) {
    // The browser freed the cursor (Esc, or an OS-level grab): mirror the
    // native focus-loss path so the game releases everything it held.
    st->push(InputEvent::focusLost(nowSeconds()));
    st->haveCursor = false;
  }
  return false;
}

bool onPointerLockError(int, const void*, void* user) {
  auto* st = static_cast<InputSharedState*>(user);
  // Refused (no gesture, or the post-Esc cooldown Chrome enforces): not
  // fatal — position-delta look keeps working, and the next canvas click
  // retries the request from inside its handler.
  logInfo("input: pointer lock refused by the browser (fallback: position-delta look; click the game to retry)");
  st->lastLockRequest = nowSeconds();  // engage the frame-loop throttle too
  return false;
}

bool onWindowFocus(int, const EmscriptenFocusEvent*, void* user) {
  auto* st = static_cast<InputSharedState*>(user);
  st->focused = true;
  ++st->focusGainedEdges;
  st->haveCursor = false;  // no motion jump from where the cursor went while away
  st->push(InputEvent::focusGained(nowSeconds()));
  if (st->debugEcho) logInfo("input> FocusGained");
  return false;
}

bool onWindowBlur(int, const EmscriptenFocusEvent*, void* user) {
  auto* st = static_cast<InputSharedState*>(user);
  st->focused = false;
  ++st->focusLostEdges;
  st->push(InputEvent::focusLost(nowSeconds()));
  if (st->debugEcho) logInfo("input> FocusLost");
  return false;
}

/// HTML5 input backend for the browser window: DOM events in, InputEvents
/// out — the GLFW backend's contract on web primitives. Registered on the
/// calling thread (under PROXY_TO_PTHREAD that is the proxied main pthread,
/// the same thread the game loop polls from).
class EmscriptenHtml5InputBackend final : public IInputBackend {
 public:
  explicit EmscriptenHtml5InputBackend(std::shared_ptr<InputSharedState> st) : st_(std::move(st)) {
    InputSharedState* raw = st_.get();
    // Instrumentation switch: ?debuginput=1 in the page URL (read once,
    // here, straight from the address bar the player actually used).
    st_->debugEcho = EM_ASM_INT({ return new URLSearchParams(location.search).has('debuginput') ? 1 : 0; }) != 0;
    st_->moveEchoBudget = st_->debugEcho ? 24 : 0;
    // Keyboard on the document: keys belong to whichever frame holds the
    // browser's focus (itch focuses its game iframe on click), and document
    // delivery works regardless of which element inside the frame is focused.
    emscripten_set_keydown_callback(EMSCRIPTEN_EVENT_TARGET_DOCUMENT, raw, EM_FALSE, &onKeyDown);
    emscripten_set_keyup_callback(EMSCRIPTEN_EVENT_TARGET_DOCUMENT, raw, EM_FALSE, &onKeyUp);
    emscripten_set_mousedown_callback("#canvas", raw, EM_FALSE, &onMouseDown);
    emscripten_set_mouseup_callback("#canvas", raw, EM_FALSE, &onMouseUp);
    emscripten_set_mousemove_callback("#canvas", raw, EM_FALSE, &onMouseMove);
    emscripten_set_wheel_callback("#canvas", raw, EM_FALSE, &onWheel);
    emscripten_set_pointerlockchange_callback(EMSCRIPTEN_EVENT_TARGET_DOCUMENT, raw, EM_FALSE, &onPointerLockChange);
    emscripten_set_pointerlockerror_callback(EMSCRIPTEN_EVENT_TARGET_DOCUMENT, raw, EM_FALSE, &onPointerLockError);
    emscripten_set_focus_callback(EMSCRIPTEN_EVENT_TARGET_WINDOW, raw, EM_FALSE, &onWindowFocus);
    emscripten_set_blur_callback(EMSCRIPTEN_EVENT_TARGET_WINDOW, raw, EM_FALSE, &onWindowBlur);
    logInfo("input: emscripten-html5 backend live (keyboard=document, mouse+wheel=#canvas, pointer lock armed; debug echo %s)",
            st_->debugEcho ? "ON (?debuginput=1)" : "off");
  }

  std::string_view name() const override { return "emscripten-html5"; }

  void poll(std::vector<InputEvent>& out) override {
    std::lock_guard lock(st_->mutex);
    out.insert(out.end(), st_->queue.begin(), st_->queue.end());
    st_->queue.clear();
  }

 private:
  std::shared_ptr<InputSharedState> st_;
};

}  // namespace

struct Window::Impl {
  std::shared_ptr<InputSharedState> inputState = std::make_shared<InputSharedState>();
  std::unique_ptr<IInputBackend> input = std::make_unique<EmscriptenHtml5InputBackend>(inputState);
  std::string clipboard;  // page-session clipboard only (not the OS clipboard)
  bool closeRequested = false;
  int fbW = 0, fbH = 0;
  EMSCRIPTEN_WEBGL_CONTEXT_HANDLE glCtx = 0;  // OpenGL33 windows only
};

std::unique_ptr<Window> Window::create(const WindowDesc& d) {
  auto w = std::make_unique<Window>(Passkey{});
  w->api_ = d.api;
  w->impl_ = std::make_unique<Impl>();
  w->vsync_ = d.vsync;
  w->winW_ = d.width;
  w->winH_ = d.height;
  w->display_ = d.display;
  w->impl_->fbW = d.width;
  w->impl_->fbH = d.height;
  // Size the page canvas to the requested window. Failure is non-fatal: the
  // shell page may manage the canvas itself; framebufferSize() then reports
  // the desc size until the element exists.
  emscripten_set_canvas_element_size("#canvas", d.width, d.height);
  logInfo("window: emscripten window %dx%d (api %s)", d.width, d.height,
          d.api == GraphicsApi::Vulkan ? "vulkan" : "gl33");
  if (d.api == GraphicsApi::OpenGL33) {
    EmscriptenWebGLContextAttributes attrs;
    emscripten_webgl_init_context_attributes(&attrs);
    attrs.alpha = EM_FALSE;
    attrs.depth = EM_TRUE;
    attrs.stencil = EM_TRUE;
    attrs.antialias = EM_FALSE;
    // Test-build choice: keep the last presented frame in the drawing
    // buffer so it stays inspectable after main() returns (a screenshot
    // taken post-exit must not race the compositor's buffer clear).
    attrs.preserveDrawingBuffer = EM_TRUE;
    attrs.majorVersion = 2;  // WebGL2 == GLES3, the GL33 backend's dialect
    attrs.minorVersion = 0;
    attrs.enableExtensionsByDefault = EM_TRUE;
    const EMSCRIPTEN_WEBGL_CONTEXT_HANDLE ctx = emscripten_webgl_create_context("#canvas", &attrs);
    if (ctx > 0) {
      w->impl_->glCtx = ctx;
      emscripten_webgl_make_context_current(ctx);
      logInfo("window: WebGL2 context current on #canvas");
    } else {
      logError("window: WebGL2 context creation failed — GL backends will fail their own init gates");
    }
  }
  return w;
}

const char* displayModeName(DisplayMode m) {
  switch (m) {
    case DisplayMode::Windowed: return "windowed";
    case DisplayMode::Maximized: return "maximized";
    case DisplayMode::Borderless: return "borderless";
    case DisplayMode::Fullscreen: return "fullscreen";
  }
  return "windowed";
}

bool parseDisplayMode(const std::string& s, DisplayMode& out) {
  for (DisplayMode m : {DisplayMode::Windowed, DisplayMode::Maximized, DisplayMode::Borderless, DisplayMode::Fullscreen})
    if (s == displayModeName(m)) { out = m; return true; }
  return false;
}

void Window::setDisplay(const DisplayDesc& d) {
  display_ = d;
  if (d.mode != DisplayMode::Windowed) lastFull_ = d.mode;
  if (d.width > 0 && d.height > 0) {
    winW_ = d.width;
    winH_ = d.height;
    impl_->fbW = d.width;
    impl_->fbH = d.height;
    emscripten_set_canvas_element_size("#canvas", d.width, d.height);
  }
}

bool Window::pollDisplayToggle() { return false; }  // no Alt+Enter on the web

