/* functional ... LithoRoot std L4 (S3, 2026-11-16): invoke/invoke_r,
 * reference_wrapper/ref/cref, the operator function objects (less,
 * greater, equal_to, plus... and their void forms), hash for scalars,
 * not_fn, bind_front, and function<R(A...)> with a small-buffer.
 *
 * hash: integers hash to themselves (as every major STL), floats hash
 * their bits with +0/-0 equal, pointers hash the address. Never used for
 * persisted or hashed engine state (plan 3.7). */
#ifndef LITHOROOT_FUNCTIONAL
#define LITHOROOT_FUNCTIONAL
#if !defined(__wasm__)
#error "LithoRoot std headers are wasm32-only; native builds use their own C++ library"
#endif
#include <cstddef>
#include <exception>
#include <memory>
#include <new>
#include <tuple>
#include <type_traits>
#include <typeinfo>
#include <utility>

namespace std {

/* ---- invoke ---- */
template <class T> class reference_wrapper;
namespace __lk {
template <class T> inline constexpr bool is_refwrap = false;
template <class T> inline constexpr bool is_refwrap<reference_wrapper<T>> = true;
}  // namespace __lk
template <class F, class... A>
constexpr invoke_result_t<F, A...> invoke(F&& f, A&&... a) noexcept(is_nothrow_invocable_v<F, A...>) {
  if constexpr (is_member_pointer_v<decay_t<F>>) {
    return [&](auto&& o, auto&&... r) -> decltype(auto) {
      using O = decltype(o);
      using C = typename __lk::mp_class<decay_t<F>>::type;
      if constexpr (is_member_function_pointer_v<decay_t<F>>) {
        if constexpr (is_base_of_v<C, remove_cvref_t<O>>) return (static_cast<O&&>(o).*f)(static_cast<decltype(r)&&>(r)...);
        else if constexpr (__lk::is_refwrap<remove_cvref_t<O>>) return (o.get().*f)(static_cast<decltype(r)&&>(r)...);
        else return ((*static_cast<O&&>(o)).*f)(static_cast<decltype(r)&&>(r)...);
      } else {
        if constexpr (is_base_of_v<C, remove_cvref_t<O>>) return static_cast<O&&>(o).*f;
        else if constexpr (__lk::is_refwrap<remove_cvref_t<O>>) return o.get().*f;
        else return (*static_cast<O&&>(o)).*f;
      }
    }(static_cast<A&&>(a)...);
  } else {
    return static_cast<F&&>(f)(static_cast<A&&>(a)...);
  }
}
template <class R, class F, class... A, class = enable_if_t<is_invocable_r_v<R, F, A...>>>
constexpr R invoke_r(F&& f, A&&... a) {
  if constexpr (is_void_v<R>) std::invoke(static_cast<F&&>(f), static_cast<A&&>(a)...);
  else return std::invoke(static_cast<F&&>(f), static_cast<A&&>(a)...);
}

/* ---- reference_wrapper ---- */
template <class T>
class reference_wrapper {
  static void fun(T&) noexcept;
  static void fun(T&&) = delete;
 public:
  using type = T;
  template <class U, class = void_t<decltype(fun(declval<U>()))>,
            class = enable_if_t<!is_same_v<remove_cvref_t<U>, reference_wrapper>>>
  constexpr reference_wrapper(U&& u) noexcept(noexcept(fun(declval<U>()))) : p_(addressof(static_cast<T&>(static_cast<U&&>(u)))) {}
  constexpr operator T&() const noexcept { return *p_; }
  constexpr T& get() const noexcept { return *p_; }
  template <class... A> constexpr invoke_result_t<T&, A...> operator()(A&&... a) const { return std::invoke(get(), static_cast<A&&>(a)...); }
 private:
  T* p_;
};
template <class T> reference_wrapper(T&) -> reference_wrapper<T>;
template <class T> constexpr reference_wrapper<T> ref(T& t) noexcept { return reference_wrapper<T>(t); }
template <class T> constexpr reference_wrapper<T> ref(reference_wrapper<T> t) noexcept { return t; }
template <class T> void ref(const T&&) = delete;
template <class T> constexpr reference_wrapper<const T> cref(const T& t) noexcept { return reference_wrapper<const T>(t); }
template <class T> constexpr reference_wrapper<const T> cref(reference_wrapper<T> t) noexcept { return reference_wrapper<const T>(t.get()); }
template <class T> void cref(const T&&) = delete;
template <class T> struct unwrap_reference { using type = T; };
template <class T> struct unwrap_reference<reference_wrapper<T>> { using type = T&; };
template <class T> using unwrap_reference_t = typename unwrap_reference<T>::type;
template <class T> struct unwrap_ref_decay : unwrap_reference<decay_t<T>> {};
template <class T> using unwrap_ref_decay_t = typename unwrap_ref_decay<T>::type;

/* ---- operator function objects ---- */
#define LR_BINOP(name, op)                                                                    \
  template <class T = void> struct name {                                                     \
    constexpr auto operator()(const T& a, const T& b) const -> decltype(a op b) { return a op b; } \
  };                                                                                          \
  template <> struct name<void> {                                                             \
    using is_transparent = void;                                                              \
    template <class A, class B> constexpr auto operator()(A&& a, B&& b) const                 \
        -> decltype(static_cast<A&&>(a) op static_cast<B&&>(b)) { return static_cast<A&&>(a) op static_cast<B&&>(b); } \
  };
LR_BINOP(plus, +) LR_BINOP(minus, -) LR_BINOP(multiplies, *) LR_BINOP(divides, /) LR_BINOP(modulus, %)
LR_BINOP(equal_to, ==) LR_BINOP(not_equal_to, !=) LR_BINOP(greater, >) LR_BINOP(less, <)
LR_BINOP(greater_equal, >=) LR_BINOP(less_equal, <=) LR_BINOP(logical_and, &&) LR_BINOP(logical_or, ||)
LR_BINOP(bit_and, &) LR_BINOP(bit_or, |) LR_BINOP(bit_xor, ^)
#undef LR_BINOP
template <class T = void> struct negate { constexpr T operator()(const T& a) const { return -a; } };
template <> struct negate<void> { using is_transparent = void; template <class A> constexpr auto operator()(A&& a) const -> decltype(-static_cast<A&&>(a)) { return -static_cast<A&&>(a); } };
template <class T = void> struct logical_not { constexpr bool operator()(const T& a) const { return !a; } };
template <> struct logical_not<void> { using is_transparent = void; template <class A> constexpr auto operator()(A&& a) const -> decltype(!static_cast<A&&>(a)) { return !static_cast<A&&>(a); } };
template <class T = void> struct bit_not { constexpr T operator()(const T& a) const { return ~a; } };
struct identity { using is_transparent = void; template <class T> constexpr T&& operator()(T&& t) const noexcept { return static_cast<T&&>(t); } };

/* ---- not_fn / bind_front ---- */
namespace __lk {
template <class F> struct not_fn_t {
  F f;
  template <class... A> constexpr auto operator()(A&&... a) & -> decltype(!std::invoke(f, static_cast<A&&>(a)...)) { return !std::invoke(f, static_cast<A&&>(a)...); }
  template <class... A> constexpr auto operator()(A&&... a) const& -> decltype(!std::invoke(f, static_cast<A&&>(a)...)) { return !std::invoke(f, static_cast<A&&>(a)...); }
};
template <class F, class... B> struct bind_front_t {
  F f;
  tuple<B...> bound;
  template <class... A> constexpr decltype(auto) operator()(A&&... a) {
    return std::apply([&](auto&... b) -> decltype(auto) { return std::invoke(f, b..., static_cast<A&&>(a)...); }, bound);
  }
  template <class... A> constexpr decltype(auto) operator()(A&&... a) const {
    return std::apply([&](const auto&... b) -> decltype(auto) { return std::invoke(f, b..., static_cast<A&&>(a)...); }, bound);
  }
};
}  // namespace __lk
template <class F> constexpr auto not_fn(F&& f) { return __lk::not_fn_t<decay_t<F>>{static_cast<F&&>(f)}; }
template <class F, class... B> constexpr auto bind_front(F&& f, B&&... b) {
  return __lk::bind_front_t<decay_t<F>, decay_t<B>...>{static_cast<F&&>(f), tuple<decay_t<B>...>(static_cast<B&&>(b)...)};
}

/* ---- hash ---- */
template <class T, class = void> struct hash {  // disabled primary: not default constructible
  hash() = delete;
  hash(const hash&) = delete;
};
#define LR_HASH_INT(T) template <> struct hash<T> { constexpr size_t operator()(T v) const noexcept { return static_cast<size_t>(v); } };
LR_HASH_INT(bool) LR_HASH_INT(char) LR_HASH_INT(signed char) LR_HASH_INT(unsigned char) LR_HASH_INT(char8_t)
LR_HASH_INT(char16_t) LR_HASH_INT(char32_t) LR_HASH_INT(wchar_t) LR_HASH_INT(short) LR_HASH_INT(unsigned short)
LR_HASH_INT(int) LR_HASH_INT(unsigned) LR_HASH_INT(long) LR_HASH_INT(unsigned long)
#undef LR_HASH_INT
/* 64-bit integers on wasm32 (size_t is 32 bits): fold the halves, so the high bits count. */
template <> struct hash<long long> { constexpr size_t operator()(long long v) const noexcept { auto u = static_cast<unsigned long long>(v); return static_cast<size_t>(u ^ (u >> 32)); } };
template <> struct hash<unsigned long long> { constexpr size_t operator()(unsigned long long u) const noexcept { return static_cast<size_t>(u ^ (u >> 32)); } };
template <> struct hash<float> { size_t operator()(float v) const noexcept { if (v == 0.0f) return 0; return __builtin_bit_cast(unsigned, v); } };
template <> struct hash<double> { size_t operator()(double v) const noexcept { if (v == 0.0) return 0; return hash<unsigned long long>()(__builtin_bit_cast(unsigned long long, v)); } };
template <> struct hash<nullptr_t> { size_t operator()(nullptr_t) const noexcept { return 0; } };
template <class T> struct hash<T*> { size_t operator()(T* p) const noexcept { return reinterpret_cast<size_t>(p); } };
template <class E> struct hash<E, enable_if_t<is_enum_v<E>>> {
  size_t operator()(E e) const noexcept { return hash<underlying_type_t<E>>()(static_cast<underlying_type_t<E>>(e)); }
};
template <class T, class D> struct hash<unique_ptr<T, D>> { size_t operator()(const unique_ptr<T, D>& p) const noexcept { return hash<typename unique_ptr<T, D>::pointer>()(p.get()); } };
template <class T> struct hash<shared_ptr<T>> { size_t operator()(const shared_ptr<T>& p) const noexcept { return hash<typename shared_ptr<T>::element_type*>()(p.get()); } };

/* ---- function ---- */
class bad_function_call : public exception {
 public:
  const char* what() const noexcept override { return "bad_function_call"; }
};
template <class> class function;

namespace __lk {
/* Small buffer: callables up to 3 pointers whose move cannot throw live inline
 * (every lambda capturing a this pointer and a couple of values); larger ones
 * go on the heap. One static ops table per callable type, no virtuals. */
inline constexpr size_t fn_sbo = 3 * sizeof(void*);
union fn_store {
  void* heap;
  alignas(alignof(max_align_t)) unsigned char buf[fn_sbo];
};
template <class F> inline constexpr bool fn_inline = sizeof(F) <= fn_sbo && alignof(F) <= alignof(max_align_t) && is_nothrow_move_constructible_v<F>;
enum class fn_op { move, copy, destroy, type };
}  // namespace __lk

template <class R, class... A>
class function<R(A...)> {
  using store = __lk::fn_store;
  using invoke_fn = R (*)(const store&, A&&...);
  using manage_fn = const void* (*)(__lk::fn_op, store*, const store*);

  template <class F> static F* target_of(const store& s) noexcept {
    if constexpr (__lk::fn_inline<F>) return const_cast<F*>(reinterpret_cast<const F*>(s.buf));
    else return static_cast<F*>(s.heap);
  }
  template <class F> static R call(const store& s, A&&... a) {
    return std::invoke_r<R>(*target_of<F>(s), static_cast<A&&>(a)...);
  }
  template <class F> static const void* manage(__lk::fn_op op, store* dst, const store* src) {
    switch (op) {
      case __lk::fn_op::move:
        if constexpr (__lk::fn_inline<F>) { ::new (dst->buf) F(std::move(*target_of<F>(*src))); target_of<F>(*src)->~F(); }
        else dst->heap = src->heap;
        return nullptr;
      case __lk::fn_op::copy:
        if constexpr (is_copy_constructible_v<F>) {
          if constexpr (__lk::fn_inline<F>) ::new (dst->buf) F(*target_of<F>(*src));
          else dst->heap = new F(*target_of<F>(*src));
        }
        return nullptr;
      case __lk::fn_op::destroy:
        if constexpr (__lk::fn_inline<F>) target_of<F>(*dst)->~F();
        else delete target_of<F>(*dst);
        return nullptr;
      case __lk::fn_op::type:
        return &typeid(F);
    }
    return nullptr;
  }
  template <class F> static bool is_null(const F& f) noexcept {  // null function pointers make an empty function
    if constexpr (is_pointer_v<F> || is_member_pointer_v<F>) return f == nullptr;
    else return false;
  }

 public:
  using result_type = R;
  function() noexcept = default;
  function(nullptr_t) noexcept {}
  function(const function& o) : invoke_(o.invoke_), manage_(o.manage_) { if (manage_) manage_(__lk::fn_op::copy, &s_, &o.s_); }
  function(function&& o) noexcept : invoke_(o.invoke_), manage_(o.manage_) {
    if (manage_) { manage_(__lk::fn_op::move, &s_, &o.s_); o.invoke_ = nullptr; o.manage_ = nullptr; }
  }
  template <class F, class D = decay_t<F>,
            class = enable_if_t<!is_same_v<D, function> && is_invocable_r_v<R, D&, A...>>>
  function(F&& f) {
    if (is_null(f)) return;
    if constexpr (__lk::fn_inline<D>) ::new (s_.buf) D(static_cast<F&&>(f));
    else s_.heap = new D(static_cast<F&&>(f));
    invoke_ = &call<D>;
    manage_ = &manage<D>;
  }
  ~function() { if (manage_) manage_(__lk::fn_op::destroy, &s_, nullptr); }
  function& operator=(const function& o) { function(o).swap(*this); return *this; }
  function& operator=(function&& o) noexcept { function(std::move(o)).swap(*this); return *this; }
  function& operator=(nullptr_t) noexcept { function().swap(*this); return *this; }
  template <class F, class = enable_if_t<!is_same_v<decay_t<F>, function>>>
  function& operator=(F&& f) { function(static_cast<F&&>(f)).swap(*this); return *this; }
  void swap(function& o) noexcept {
    if (&o == this) return;
    store tmp;
    if (manage_) manage_(__lk::fn_op::move, &tmp, &s_);
    if (o.manage_) o.manage_(__lk::fn_op::move, &s_, &o.s_);
    if (manage_) manage_(__lk::fn_op::move, &o.s_, &tmp);
    std::swap(invoke_, o.invoke_);
    std::swap(manage_, o.manage_);
  }
  explicit operator bool() const noexcept { return invoke_ != nullptr; }
  R operator()(A... a) const {
    if (!invoke_) throw bad_function_call();
    return invoke_(s_, static_cast<A&&>(a)...);
  }
  const type_info& target_type() const noexcept { return manage_ ? *static_cast<const type_info*>(manage_(__lk::fn_op::type, nullptr, nullptr)) : typeid(void); }
  template <class T> T* target() noexcept { return target_type() == typeid(T) ? target_of<T>(s_) : nullptr; }
  template <class T> const T* target() const noexcept { return target_type() == typeid(T) ? target_of<T>(s_) : nullptr; }

 private:
  store s_{};
  invoke_fn invoke_ = nullptr;
  manage_fn manage_ = nullptr;
};
template <class R, class... A> function(R (*)(A...)) -> function<R(A...)>;
namespace __lk {
template <class> struct fn_sig;
template <class R, class C, class... A> struct fn_sig<R (C::*)(A...)> { using type = R(A...); };
template <class R, class C, class... A> struct fn_sig<R (C::*)(A...) const> { using type = R(A...); };
template <class R, class C, class... A> struct fn_sig<R (C::*)(A...) noexcept> { using type = R(A...); };
template <class R, class C, class... A> struct fn_sig<R (C::*)(A...) const noexcept> { using type = R(A...); };
template <class R, class C, class... A> struct fn_sig<R (C::*)(A...) &> { using type = R(A...); };
template <class R, class C, class... A> struct fn_sig<R (C::*)(A...) const&> { using type = R(A...); };
}  // namespace __lk
template <class F, class S = typename __lk::fn_sig<decltype(&F::operator())>::type> function(F) -> function<S>;
template <class R, class... A> bool operator==(const function<R(A...)>& f, nullptr_t) noexcept { return !f; }
template <class R, class... A> void swap(function<R(A...)>& a, function<R(A...)>& b) noexcept { a.swap(b); }

}  // namespace std
#endif
