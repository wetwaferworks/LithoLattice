/* iterator ... LithoRoot std L4 (S3, 2026-11-16): iterator tags and traits,
 * advance/next/prev/distance, reverse/move/back/front/insert iterators,
 * the range access functions (begin/end/size/data/empty...). */
#ifndef LITHOROOT_ITERATOR
#define LITHOROOT_ITERATOR
#if !defined(__wasm__)
#error "LithoRoot std headers are wasm32-only; native builds use their own C++ library"
#endif
#include <cstddef>
#include <initializer_list>
#include <type_traits>
#include <utility>

namespace std {

struct input_iterator_tag {};
struct output_iterator_tag {};
struct forward_iterator_tag : input_iterator_tag {};
struct bidirectional_iterator_tag : forward_iterator_tag {};
struct random_access_iterator_tag : bidirectional_iterator_tag {};
struct contiguous_iterator_tag : random_access_iterator_tag {};

namespace __lk {
template <class I, class = void> struct iter_traits_base {};
template <class I>
struct iter_traits_base<I, void_t<typename I::iterator_category, typename I::value_type, typename I::difference_type>> {
  using iterator_category = typename I::iterator_category;
  using value_type = typename I::value_type;
  using difference_type = typename I::difference_type;
  using pointer = typename I::pointer;
  using reference = typename I::reference;
};
}  // namespace __lk
template <class I> struct iterator_traits : __lk::iter_traits_base<I> {};
template <class T> struct iterator_traits<T*> {
  using iterator_concept = contiguous_iterator_tag;
  using iterator_category = random_access_iterator_tag;
  using value_type = remove_cv_t<T>;
  using difference_type = ptrdiff_t;
  using pointer = T*;
  using reference = T&;
};
template <class I> using iter_value_t = typename iterator_traits<remove_cvref_t<I>>::value_type;
template <class I> using iter_difference_t = typename iterator_traits<remove_cvref_t<I>>::difference_type;
template <class I> using iter_reference_t = decltype(*declval<I&>());

namespace __lk {
template <class I> using cat_t = typename iterator_traits<I>::iterator_category;
template <class I, class Tag> inline constexpr bool is_cat = is_base_of_v<Tag, cat_t<I>>;
}  // namespace __lk

template <class I, class D>
constexpr void advance(I& it, D n) {
  if constexpr (__lk::is_cat<I, random_access_iterator_tag>) it += n;
  else if constexpr (__lk::is_cat<I, bidirectional_iterator_tag>) { for (; n > 0; --n) ++it; for (; n < 0; ++n) --it; }
  else { for (; n > 0; --n) ++it; }
}
template <class I>
constexpr typename iterator_traits<I>::difference_type distance(I first, I last) {
  if constexpr (__lk::is_cat<I, random_access_iterator_tag>) return last - first;
  else { typename iterator_traits<I>::difference_type n = 0; for (; first != last; ++first) ++n; return n; }
}
template <class I> constexpr I next(I it, typename iterator_traits<I>::difference_type n = 1) { std::advance(it, n); return it; }
template <class I> constexpr I prev(I it, typename iterator_traits<I>::difference_type n = 1) { std::advance(it, -n); return it; }

template <class It>
class reverse_iterator {
 public:
  using iterator_type = It;
  using iterator_category = typename iterator_traits<It>::iterator_category;
  using value_type = typename iterator_traits<It>::value_type;
  using difference_type = typename iterator_traits<It>::difference_type;
  using pointer = typename iterator_traits<It>::pointer;
  using reference = typename iterator_traits<It>::reference;
  constexpr reverse_iterator() = default;
  constexpr explicit reverse_iterator(It x) : current(x) {}
  template <class U, class = enable_if_t<is_convertible_v<const U&, It>>>
  constexpr reverse_iterator(const reverse_iterator<U>& o) : current(o.base()) {}
  constexpr It base() const { return current; }
  constexpr reference operator*() const { It t = current; return *--t; }
  constexpr pointer operator->() const { It t = current; --t; if constexpr (is_pointer_v<It>) return t; else return t.operator->(); }
  constexpr reverse_iterator& operator++() { --current; return *this; }
  constexpr reverse_iterator operator++(int) { auto t = *this; --current; return t; }
  constexpr reverse_iterator& operator--() { ++current; return *this; }
  constexpr reverse_iterator operator--(int) { auto t = *this; ++current; return t; }
  constexpr reverse_iterator operator+(difference_type n) const { return reverse_iterator(current - n); }
  constexpr reverse_iterator operator-(difference_type n) const { return reverse_iterator(current + n); }
  constexpr reverse_iterator& operator+=(difference_type n) { current -= n; return *this; }
  constexpr reverse_iterator& operator-=(difference_type n) { current += n; return *this; }
  constexpr reference operator[](difference_type n) const { return *(*this + n); }
 protected:
  It current{};
};
template <class A, class B> constexpr bool operator==(const reverse_iterator<A>& a, const reverse_iterator<B>& b) { return a.base() == b.base(); }
template <class A, class B> constexpr bool operator!=(const reverse_iterator<A>& a, const reverse_iterator<B>& b) { return a.base() != b.base(); }
template <class A, class B> constexpr bool operator<(const reverse_iterator<A>& a, const reverse_iterator<B>& b) { return a.base() > b.base(); }
template <class A, class B> constexpr bool operator>(const reverse_iterator<A>& a, const reverse_iterator<B>& b) { return a.base() < b.base(); }
template <class A, class B> constexpr bool operator<=(const reverse_iterator<A>& a, const reverse_iterator<B>& b) { return a.base() >= b.base(); }
template <class A, class B> constexpr bool operator>=(const reverse_iterator<A>& a, const reverse_iterator<B>& b) { return a.base() <= b.base(); }
template <class A, class B> constexpr auto operator-(const reverse_iterator<A>& a, const reverse_iterator<B>& b) -> decltype(b.base() - a.base()) { return b.base() - a.base(); }
template <class It> constexpr reverse_iterator<It> operator+(typename reverse_iterator<It>::difference_type n, const reverse_iterator<It>& r) { return r + n; }
template <class It> constexpr reverse_iterator<It> make_reverse_iterator(It i) { return reverse_iterator<It>(i); }

template <class It>
class move_iterator {
 public:
  using iterator_type = It;
  using iterator_category = typename iterator_traits<It>::iterator_category;
  using value_type = typename iterator_traits<It>::value_type;
  using difference_type = typename iterator_traits<It>::difference_type;
  using pointer = It;
  using reference = conditional_t<is_reference_v<typename iterator_traits<It>::reference>,
                                  remove_reference_t<typename iterator_traits<It>::reference>&&,
                                  typename iterator_traits<It>::reference>;
  constexpr move_iterator() = default;
  constexpr explicit move_iterator(It i) : current(i) {}
  constexpr It base() const { return current; }
  constexpr reference operator*() const { return static_cast<reference>(*current); }
  constexpr move_iterator& operator++() { ++current; return *this; }
  constexpr move_iterator operator++(int) { auto t = *this; ++current; return t; }
  constexpr move_iterator& operator--() { --current; return *this; }
  constexpr move_iterator operator--(int) { auto t = *this; --current; return t; }
  constexpr move_iterator operator+(difference_type n) const { return move_iterator(current + n); }
  constexpr move_iterator operator-(difference_type n) const { return move_iterator(current - n); }
  constexpr move_iterator& operator+=(difference_type n) { current += n; return *this; }
  constexpr move_iterator& operator-=(difference_type n) { current -= n; return *this; }
  constexpr reference operator[](difference_type n) const { return std::move(current[n]); }
 private:
  It current{};
};
template <class A, class B> constexpr bool operator==(const move_iterator<A>& a, const move_iterator<B>& b) { return a.base() == b.base(); }
template <class A, class B> constexpr bool operator!=(const move_iterator<A>& a, const move_iterator<B>& b) { return a.base() != b.base(); }
template <class A, class B> constexpr bool operator<(const move_iterator<A>& a, const move_iterator<B>& b) { return a.base() < b.base(); }
template <class A, class B> constexpr auto operator-(const move_iterator<A>& a, const move_iterator<B>& b) -> decltype(a.base() - b.base()) { return a.base() - b.base(); }
template <class It> constexpr move_iterator<It> make_move_iterator(It i) { return move_iterator<It>(i); }

template <class C>
class back_insert_iterator {
 public:
  using iterator_category = output_iterator_tag;
  using value_type = void; using difference_type = ptrdiff_t; using pointer = void; using reference = void;
  using container_type = C;
  constexpr explicit back_insert_iterator(C& c) : container(addressof(c)) {}
  constexpr back_insert_iterator& operator=(const typename C::value_type& v) { container->push_back(v); return *this; }
  constexpr back_insert_iterator& operator=(typename C::value_type&& v) { container->push_back(std::move(v)); return *this; }
  constexpr back_insert_iterator& operator*() { return *this; }
  constexpr back_insert_iterator& operator++() { return *this; }
  constexpr back_insert_iterator operator++(int) { return *this; }
 protected:
  C* container;
};
template <class C> constexpr back_insert_iterator<C> back_inserter(C& c) { return back_insert_iterator<C>(c); }

template <class C>
class front_insert_iterator {
 public:
  using iterator_category = output_iterator_tag;
  using value_type = void; using difference_type = ptrdiff_t; using pointer = void; using reference = void;
  using container_type = C;
  constexpr explicit front_insert_iterator(C& c) : container(addressof(c)) {}
  constexpr front_insert_iterator& operator=(const typename C::value_type& v) { container->push_front(v); return *this; }
  constexpr front_insert_iterator& operator=(typename C::value_type&& v) { container->push_front(std::move(v)); return *this; }
  constexpr front_insert_iterator& operator*() { return *this; }
  constexpr front_insert_iterator& operator++() { return *this; }
  constexpr front_insert_iterator operator++(int) { return *this; }
 protected:
  C* container;
};
template <class C> constexpr front_insert_iterator<C> front_inserter(C& c) { return front_insert_iterator<C>(c); }

template <class C>
class insert_iterator {
 public:
  using iterator_category = output_iterator_tag;
  using value_type = void; using difference_type = ptrdiff_t; using pointer = void; using reference = void;
  using container_type = C;
  constexpr insert_iterator(C& c, typename C::iterator i) : container(addressof(c)), iter(i) {}
  constexpr insert_iterator& operator=(const typename C::value_type& v) { iter = container->insert(iter, v); ++iter; return *this; }
  constexpr insert_iterator& operator=(typename C::value_type&& v) { iter = container->insert(iter, std::move(v)); ++iter; return *this; }
  constexpr insert_iterator& operator*() { return *this; }
  constexpr insert_iterator& operator++() { return *this; }
  constexpr insert_iterator& operator++(int) { return *this; }
 protected:
  C* container;
  typename C::iterator iter;
};
template <class C> constexpr insert_iterator<C> inserter(C& c, typename C::iterator i) { return insert_iterator<C>(c, i); }

/* Range access. */
template <class C> constexpr auto begin(C& c) -> decltype(c.begin()) { return c.begin(); }
template <class C> constexpr auto begin(const C& c) -> decltype(c.begin()) { return c.begin(); }
template <class C> constexpr auto end(C& c) -> decltype(c.end()) { return c.end(); }
template <class C> constexpr auto end(const C& c) -> decltype(c.end()) { return c.end(); }
template <class T, size_t N> constexpr T* begin(T (&a)[N]) noexcept { return a; }
template <class T, size_t N> constexpr T* end(T (&a)[N]) noexcept { return a + N; }
template <class C> constexpr auto cbegin(const C& c) -> decltype(std::begin(c)) { return std::begin(c); }
template <class C> constexpr auto cend(const C& c) -> decltype(std::end(c)) { return std::end(c); }
template <class C> constexpr auto rbegin(C& c) -> decltype(c.rbegin()) { return c.rbegin(); }
template <class C> constexpr auto rbegin(const C& c) -> decltype(c.rbegin()) { return c.rbegin(); }
template <class C> constexpr auto rend(C& c) -> decltype(c.rend()) { return c.rend(); }
template <class C> constexpr auto rend(const C& c) -> decltype(c.rend()) { return c.rend(); }
template <class T, size_t N> constexpr reverse_iterator<T*> rbegin(T (&a)[N]) { return reverse_iterator<T*>(a + N); }
template <class T, size_t N> constexpr reverse_iterator<T*> rend(T (&a)[N]) { return reverse_iterator<T*>(a); }
template <class C> constexpr auto crbegin(const C& c) -> decltype(std::rbegin(c)) { return std::rbegin(c); }
template <class C> constexpr auto crend(const C& c) -> decltype(std::rend(c)) { return std::rend(c); }
template <class C> constexpr auto size(const C& c) -> decltype(c.size()) { return c.size(); }
template <class T, size_t N> constexpr size_t size(const T (&)[N]) noexcept { return N; }
template <class C> constexpr auto ssize(const C& c) -> common_type_t<ptrdiff_t, make_signed_t<decltype(c.size())>> {
  return static_cast<common_type_t<ptrdiff_t, make_signed_t<decltype(c.size())>>>(c.size());
}
template <class T, ptrdiff_t N> constexpr ptrdiff_t ssize(const T (&)[N]) noexcept { return N; }
template <class C> [[nodiscard]] constexpr auto empty(const C& c) -> decltype(c.empty()) { return c.empty(); }
template <class T, size_t N> [[nodiscard]] constexpr bool empty(const T (&)[N]) noexcept { return false; }
template <class E> [[nodiscard]] constexpr bool empty(initializer_list<E> il) noexcept { return il.size() == 0; }
template <class C> constexpr auto data(C& c) -> decltype(c.data()) { return c.data(); }
template <class C> constexpr auto data(const C& c) -> decltype(c.data()) { return c.data(); }
template <class T, size_t N> constexpr T* data(T (&a)[N]) noexcept { return a; }
template <class E> constexpr const E* data(initializer_list<E> il) noexcept { return il.begin(); }

}  // namespace std
