namespace std {

struct nullopt_t { struct tag {}; constexpr explicit nullopt_t(tag) {} };
inline constexpr nullopt_t nullopt{nullopt_t::tag{}};
class bad_optional_access : public exception {
 public:
  const char* what() const noexcept override { return "bad_optional_access"; }
};
template <class T> class optional;

namespace __lk {
template <class T, bool = is_trivially_destructible_v<T>> struct opt_store {
  union { char dummy_; T val_; };
  bool has_ = false;
  constexpr opt_store() noexcept : dummy_() {}
  template <class... A> constexpr explicit opt_store(in_place_t, A&&... a) : val_(std::forward<A>(a)...), has_(true) {}
  constexpr void reset() noexcept { has_ = false; }
};
template <class T> struct opt_store<T, false> {
  union { char dummy_; T val_; };
  bool has_ = false;
  constexpr opt_store() noexcept : dummy_() {}
  template <class... A> constexpr explicit opt_store(in_place_t, A&&... a) : val_(std::forward<A>(a)...), has_(true) {}
  constexpr ~opt_store() { if (has_) val_.~T(); }
  opt_store(const opt_store&) = default;
  opt_store(opt_store&&) = default;
  opt_store& operator=(const opt_store&) = default;
  opt_store& operator=(opt_store&&) = default;
  constexpr void reset() noexcept { if (has_) { val_.~T(); has_ = false; } }
};
template <class T> inline constexpr bool is_optional = false;
template <class T> inline constexpr bool is_optional<optional<T>> = true;
}  // namespace __lk

template <class T>
class optional : private __lk::opt_store<T> {
  using base = __lk::opt_store<T>;
  static_assert(!is_reference_v<T> && !is_same_v<remove_cv_t<T>, nullopt_t> && !is_same_v<remove_cv_t<T>, in_place_t>);
  template <class... A> constexpr void construct(A&&... a) { std::construct_at(addressof(this->val_), std::forward<A>(a)...); this->has_ = true; }
 public:
  using value_type = T;
  constexpr optional() noexcept {}
  constexpr optional(nullopt_t) noexcept {}
  constexpr optional(const optional& o) requires is_trivially_copy_constructible_v<T> = default;
  constexpr optional(const optional& o) requires(!is_trivially_copy_constructible_v<T> && is_copy_constructible_v<T>) { if (o.has_) construct(o.val_); }
  constexpr optional(optional&& o) noexcept(is_nothrow_move_constructible_v<T>) requires is_trivially_move_constructible_v<T> = default;
  constexpr optional(optional&& o) noexcept(is_nothrow_move_constructible_v<T>) requires(!is_trivially_move_constructible_v<T> && is_move_constructible_v<T>) { if (o.has_) construct(std::move(o.val_)); }
  template <class... A> constexpr explicit optional(in_place_t, A&&... a) : base(in_place, std::forward<A>(a)...) {}
  template <class U, class... A> constexpr explicit optional(in_place_t, initializer_list<U> il, A&&... a) : base(in_place, il, std::forward<A>(a)...) {}
  template <class U = T, class = enable_if_t<is_constructible_v<T, U&&> && !is_same_v<remove_cvref_t<U>, in_place_t> && !is_same_v<remove_cvref_t<U>, optional>>>
  constexpr explicit(!is_convertible_v<U&&, T>) optional(U&& v) : base(in_place, std::forward<U>(v)) {}
  template <class U, class = enable_if_t<!is_same_v<U, T> && is_constructible_v<T, const U&>>>
  constexpr explicit(!is_convertible_v<const U&, T>) optional(const optional<U>& o) { if (o) construct(*o); }
  template <class U, class = enable_if_t<!is_same_v<U, T> && is_constructible_v<T, U&&>>>
  constexpr explicit(!is_convertible_v<U&&, T>) optional(optional<U>&& o) { if (o) construct(std::move(*o)); }

  constexpr optional& operator=(nullopt_t) noexcept { this->reset(); return *this; }
  constexpr optional& operator=(const optional& o) requires(is_trivially_copy_assignable_v<T> && is_trivially_copy_constructible_v<T> && is_trivially_destructible_v<T>) = default;
  constexpr optional& operator=(const optional& o) requires(!(is_trivially_copy_assignable_v<T> && is_trivially_copy_constructible_v<T> && is_trivially_destructible_v<T>) && is_copy_constructible_v<T> && is_copy_assignable_v<T>) {
    if (o.has_) { if (this->has_) this->val_ = o.val_; else construct(o.val_); } else this->reset();
    return *this;
  }
  constexpr optional& operator=(optional&& o) noexcept(is_nothrow_move_assignable_v<T> && is_nothrow_move_constructible_v<T>) requires(is_trivially_move_assignable_v<T> && is_trivially_move_constructible_v<T> && is_trivially_destructible_v<T>) = default;
  constexpr optional& operator=(optional&& o) noexcept(is_nothrow_move_assignable_v<T> && is_nothrow_move_constructible_v<T>) requires(!(is_trivially_move_assignable_v<T> && is_trivially_move_constructible_v<T> && is_trivially_destructible_v<T>) && is_move_constructible_v<T> && is_move_assignable_v<T>) {
    if (o.has_) { if (this->has_) this->val_ = std::move(o.val_); else construct(std::move(o.val_)); } else this->reset();
    return *this;
  }
  template <class U = T, class = enable_if_t<!is_same_v<remove_cvref_t<U>, optional> && is_constructible_v<T, U> && is_assignable_v<T&, U>>>
  constexpr optional& operator=(U&& v) { if (this->has_) this->val_ = std::forward<U>(v); else construct(std::forward<U>(v)); return *this; }
  template <class U, class = enable_if_t<!is_same_v<U, T>>> constexpr optional& operator=(const optional<U>& o) { if (o) *this = *o; else this->reset(); return *this; }
  template <class U, class = enable_if_t<!is_same_v<U, T>>> constexpr optional& operator=(optional<U>&& o) { if (o) *this = std::move(*o); else this->reset(); return *this; }
  template <class... A> constexpr T& emplace(A&&... a) { this->reset(); construct(std::forward<A>(a)...); return this->val_; }
  template <class U, class... A> constexpr T& emplace(initializer_list<U> il, A&&... a) { this->reset(); construct(il, std::forward<A>(a)...); return this->val_; }
  constexpr void swap(optional& o) noexcept(is_nothrow_move_constructible_v<T> && is_nothrow_swappable_v<T>) {
    if (this->has_ && o.has_) { using std::swap; swap(this->val_, o.val_); }
    else if (this->has_) { o.construct(std::move(this->val_)); this->reset(); }
    else if (o.has_) { construct(std::move(o.val_)); o.reset(); }
  }
  using base::reset;

  constexpr const T* operator->() const noexcept { return addressof(this->val_); }
  constexpr T* operator->() noexcept { return addressof(this->val_); }
  constexpr const T& operator*() const& noexcept { return this->val_; }
  constexpr T& operator*() & noexcept { return this->val_; }
  constexpr T&& operator*() && noexcept { return std::move(this->val_); }
  constexpr const T&& operator*() const&& noexcept { return std::move(this->val_); }
  constexpr explicit operator bool() const noexcept { return this->has_; }
  constexpr bool has_value() const noexcept { return this->has_; }
  constexpr T& value() & { if (!this->has_) throw bad_optional_access(); return this->val_; }
  constexpr const T& value() const& { if (!this->has_) throw bad_optional_access(); return this->val_; }
  constexpr T&& value() && { if (!this->has_) throw bad_optional_access(); return std::move(this->val_); }
  constexpr const T&& value() const&& { if (!this->has_) throw bad_optional_access(); return std::move(this->val_); }
  template <class U> constexpr T value_or(U&& d) const& { return this->has_ ? this->val_ : static_cast<T>(std::forward<U>(d)); }
  template <class U> constexpr T value_or(U&& d) && { return this->has_ ? std::move(this->val_) : static_cast<T>(std::forward<U>(d)); }
  template <class F> constexpr auto and_then(F&& f) & { using R = remove_cvref_t<invoke_result_t<F, T&>>; return this->has_ ? std::invoke(std::forward<F>(f), this->val_) : R(); }
  template <class F> constexpr auto and_then(F&& f) const& { using R = remove_cvref_t<invoke_result_t<F, const T&>>; return this->has_ ? std::invoke(std::forward<F>(f), this->val_) : R(); }
  template <class F> constexpr auto transform(F&& f) const& {
    using U = remove_cv_t<invoke_result_t<F, const T&>>;
    return this->has_ ? optional<U>(std::invoke(std::forward<F>(f), this->val_)) : optional<U>();
  }
  template <class F> constexpr optional or_else(F&& f) const& { return this->has_ ? *this : std::forward<F>(f)(); }
};
template <class T> optional(T) -> optional<T>;

template <class T, class U> constexpr bool operator==(const optional<T>& a, const optional<U>& b) { return bool(a) != bool(b) ? false : !a ? true : *a == *b; }
template <class T, class U> constexpr bool operator<(const optional<T>& a, const optional<U>& b) { return !b ? false : !a ? true : *a < *b; }
template <class T, class U> constexpr bool operator>(const optional<T>& a, const optional<U>& b) { return b < a; }
template <class T, class U> constexpr bool operator<=(const optional<T>& a, const optional<U>& b) { return !(b < a); }
template <class T, class U> constexpr bool operator>=(const optional<T>& a, const optional<U>& b) { return !(a < b); }
template <class T> constexpr bool operator==(const optional<T>& a, nullopt_t) noexcept { return !a; }
template <class T> constexpr strong_ordering operator<=>(const optional<T>& a, nullopt_t) noexcept { return bool(a) <=> false; }
template <class T, class U, class = enable_if_t<!__lk::is_optional<U>>> constexpr bool operator==(const optional<T>& a, const U& v) { return a && *a == v; }
template <class T, class U, class = enable_if_t<!__lk::is_optional<U>>> constexpr bool operator<(const optional<T>& a, const U& v) { return !a || *a < v; }
template <class T, class U, class = enable_if_t<!__lk::is_optional<U>>> constexpr bool operator>(const optional<T>& a, const U& v) { return a && v < *a; }
template <class T, class U, class = enable_if_t<!__lk::is_optional<T>>> constexpr bool operator<(const T& v, const optional<U>& a) { return a && v < *a; }
template <class T, class U, class = enable_if_t<!__lk::is_optional<T>>> constexpr bool operator>(const T& v, const optional<U>& a) { return !a || *a < v; }
template <class T> constexpr void swap(optional<T>& a, optional<T>& b) noexcept(noexcept(a.swap(b))) { a.swap(b); }
template <class T> constexpr optional<decay_t<T>> make_optional(T&& v) { return optional<decay_t<T>>(std::forward<T>(v)); }
template <class T, class... A> constexpr optional<T> make_optional(A&&... a) { return optional<T>(in_place, std::forward<A>(a)...); }
template <class T> struct hash<optional<T>> {
  size_t operator()(const optional<T>& o) const noexcept { return o ? hash<remove_const_t<T>>()(*o) : size_t(0x9e3779b9u); }
};

}  // namespace std
#endif
