template <class A>
struct allocator_traits {
  using allocator_type = A;
  using value_type = typename A::value_type;
  using pointer = typename __lk::alloc_ptr<A>::type;
  using const_pointer = const value_type*;
  using void_pointer = void*;
  using const_void_pointer = const void*;
  using difference_type = ptrdiff_t;
  using size_type = size_t;
  using propagate_on_container_copy_assignment = typename __lk::alloc_pocca<A>::type;
  using propagate_on_container_move_assignment = typename __lk::alloc_pocma<A>::type;
  using propagate_on_container_swap = typename __lk::alloc_pocs<A>::type;
  using is_always_equal = typename __lk::alloc_equal<A>::type;
  template <class U> using rebind_alloc = typename __lk::alloc_rebind<A, U>::type;
  template <class U> using rebind_traits = allocator_traits<rebind_alloc<U>>;
  [[nodiscard]] static pointer allocate(A& a, size_type n) { return a.allocate(n); }
  static void deallocate(A& a, pointer p, size_type n) { a.deallocate(p, n); }
  template <class T, class... Args> static void construct(A&, T* p, Args&&... args) { std::construct_at(p, std::forward<Args>(args)...); }
  template <class T> static void destroy(A&, T* p) { std::destroy_at(p); }
  static size_type max_size(const A&) noexcept { return size_type(-1) / sizeof(value_type); }
  static A select_on_container_copy_construction(const A& a) { return a; }
};

/* ---- unique_ptr ---- */
template <class T> struct default_delete {
  constexpr default_delete() noexcept = default;
  template <class U, class = enable_if_t<is_convertible_v<U*, T*>>> default_delete(const default_delete<U>&) noexcept {}
  void operator()(T* p) const {
    static_assert(sizeof(T) > 0, "default_delete of an incomplete type");
    delete p;
  }
};
template <class T> struct default_delete<T[]> {
  constexpr default_delete() noexcept = default;
  template <class U, class = enable_if_t<is_convertible_v<U (*)[], T (*)[]>>> default_delete(const default_delete<U[]>&) noexcept {}
  template <class U, class = enable_if_t<is_convertible_v<U (*)[], T (*)[]>>> void operator()(U* p) const {
    static_assert(sizeof(U) > 0, "default_delete of an incomplete type");
    delete[] p;
  }
};

namespace __lk {
template <class T, class D, class = void> struct up_ptr { using type = T*; };
template <class T, class D> struct up_ptr<T, D, void_t<typename remove_reference_t<D>::pointer>> { using type = typename remove_reference_t<D>::pointer; };
/* Empty deleters take no space ([[no_unique_address]], as the ABI of every major STL). */
template <class P, class D> struct up_pair {
  P p;
  [[no_unique_address]] D d;
};
}  // namespace __lk

template <class T, class D = default_delete<T>>
class unique_ptr {
 public:
  using pointer = typename __lk::up_ptr<T, D>::type;
  using element_type = T;
  using deleter_type = D;
  constexpr unique_ptr() noexcept : s_{pointer(), D()} {}
  constexpr unique_ptr(nullptr_t) noexcept : unique_ptr() {}
  explicit unique_ptr(pointer p) noexcept : s_{p, D()} {}
  template <class E = D, enable_if_t<!is_reference_v<E>, int> = 0> unique_ptr(pointer p, const D& d) noexcept : s_{p, d} {}
  template <class E = D, enable_if_t<!is_reference_v<E>, int> = 0> unique_ptr(pointer p, D&& d) noexcept : s_{p, std::move(d)} {}
  template <class E = D, enable_if_t<is_reference_v<E>, int> = 0> unique_ptr(pointer p, D d) noexcept : s_{p, d} {}
  unique_ptr(unique_ptr&& o) noexcept : s_{o.release(), std::forward<D>(o.get_deleter())} {}
  template <class U, class E,
            class = enable_if_t<!is_array_v<U> && is_convertible_v<typename unique_ptr<U, E>::pointer, pointer> &&
                                (is_reference_v<D> ? is_same_v<E, D> : is_convertible_v<E, D>)>>
  unique_ptr(unique_ptr<U, E>&& o) noexcept : s_{o.release(), std::forward<E>(o.get_deleter())} {}
  unique_ptr(const unique_ptr&) = delete;
  unique_ptr& operator=(const unique_ptr&) = delete;
  ~unique_ptr() { if (s_.p) s_.d(s_.p); }
  unique_ptr& operator=(unique_ptr&& o) noexcept { reset(o.release()); s_.d = std::forward<D>(o.get_deleter()); return *this; }
  template <class U, class E, class = enable_if_t<!is_array_v<U> && is_convertible_v<typename unique_ptr<U, E>::pointer, pointer>>>
  unique_ptr& operator=(unique_ptr<U, E>&& o) noexcept { reset(o.release()); s_.d = std::forward<E>(o.get_deleter()); return *this; }
  unique_ptr& operator=(nullptr_t) noexcept { reset(); return *this; }
  add_lvalue_reference_t<T> operator*() const { return *s_.p; }
  pointer operator->() const noexcept { return s_.p; }
  pointer get() const noexcept { return s_.p; }
  D& get_deleter() noexcept { return s_.d; }
  const D& get_deleter() const noexcept { return s_.d; }
  explicit operator bool() const noexcept { return s_.p != pointer(); }
  pointer release() noexcept { pointer p = s_.p; s_.p = pointer(); return p; }
  void reset(pointer p = pointer()) noexcept { pointer old = s_.p; s_.p = p; if (old) s_.d(old); }
  void swap(unique_ptr& o) noexcept { using std::swap; swap(s_.p, o.s_.p); swap(s_.d, o.s_.d); }
 private:
  __lk::up_pair<pointer, D> s_;
};

template <class T, class D>
class unique_ptr<T[], D> {
 public:
  using pointer = typename __lk::up_ptr<T, D>::type;
  using element_type = T;
  using deleter_type = D;
  constexpr unique_ptr() noexcept : s_{pointer(), D()} {}
  constexpr unique_ptr(nullptr_t) noexcept : unique_ptr() {}
  template <class U, class = enable_if_t<is_same_v<U, pointer> || is_same_v<U, nullptr_t>>> explicit unique_ptr(U p) noexcept : s_{p, D()} {}
  template <class U, class = enable_if_t<is_same_v<U, pointer> || is_same_v<U, nullptr_t>>> unique_ptr(U p, const D& d) noexcept : s_{p, d} {}
  unique_ptr(unique_ptr&& o) noexcept : s_{o.release(), std::forward<D>(o.get_deleter())} {}
  unique_ptr(const unique_ptr&) = delete;
  unique_ptr& operator=(const unique_ptr&) = delete;
  ~unique_ptr() { if (s_.p) s_.d(s_.p); }
  unique_ptr& operator=(unique_ptr&& o) noexcept { reset(o.release()); s_.d = std::forward<D>(o.get_deleter()); return *this; }
  unique_ptr& operator=(nullptr_t) noexcept { reset(); return *this; }
  T& operator[](size_t i) const { return s_.p[i]; }
  pointer get() const noexcept { return s_.p; }
  D& get_deleter() noexcept { return s_.d; }
  const D& get_deleter() const noexcept { return s_.d; }
  explicit operator bool() const noexcept { return s_.p != pointer(); }
  pointer release() noexcept { pointer p = s_.p; s_.p = pointer(); return p; }
  template <class U, class = enable_if_t<is_same_v<U, pointer> || is_same_v<U, nullptr_t>>>
  void reset(U p) noexcept { pointer old = s_.p; s_.p = p; if (old) s_.d(old); }
  void reset(nullptr_t = nullptr) noexcept { reset(pointer()); }
  void swap(unique_ptr& o) noexcept { using std::swap; swap(s_.p, o.s_.p); swap(s_.d, o.s_.d); }
 private:
  __lk::up_pair<pointer, D> s_;
};

template <class T, class... A, enable_if_t<!is_array_v<T>, int> = 0>
unique_ptr<T> make_unique(A&&... a) { return unique_ptr<T>(new T(std::forward<A>(a)...)); }
template <class T, enable_if_t<is_array_v<T> && extent_v<T> == 0, int> = 0>
unique_ptr<T> make_unique(size_t n) { return unique_ptr<T>(new remove_extent_t<T>[n]()); }
template <class T, class... A, enable_if_t<extent_v<T> != 0, int> = 0> void make_unique(A&&...) = delete;
template <class T, enable_if_t<!is_array_v<T>, int> = 0>
unique_ptr<T> make_unique_for_overwrite() { return unique_ptr<T>(new T); }
template <class T, enable_if_t<is_array_v<T> && extent_v<T> == 0, int> = 0>
unique_ptr<T> make_unique_for_overwrite(size_t n) { return unique_ptr<T>(new remove_extent_t<T>[n]); }

template <class T, class D> void swap(unique_ptr<T, D>& a, unique_ptr<T, D>& b) noexcept { a.swap(b); }
template <class T1, class D1, class T2, class D2> bool operator==(const unique_ptr<T1, D1>& a, const unique_ptr<T2, D2>& b) { return a.get() == b.get(); }
template <class T1, class D1, class T2, class D2> bool operator<(const unique_ptr<T1, D1>& a, const unique_ptr<T2, D2>& b) { return a.get() < b.get(); }
template <class T, class D> bool operator==(const unique_ptr<T, D>& a, nullptr_t) noexcept { return !a; }

/* ---- shared_ptr ---- */
class bad_weak_ptr : public exception {
 public:
  const char* what() const noexcept override { return "bad_weak_ptr"; }
};

namespace __lk {
/* Control block: `shared` counts owners; `weak` counts weak_ptrs plus one for
 * the owner group as a whole, so the block dies when the last of either goes. */
struct ctrl {
  long shared = 1;
  long weak = 1;
  virtual void dispose() noexcept = 0;  // destroy the managed object
  virtual void destroy() noexcept = 0;  // free this block
  virtual void* get_deleter(const type_info&) noexcept { return nullptr; }
  void add_shared() noexcept { __atomic_fetch_add(&shared, 1, __ATOMIC_RELAXED); }
  void add_weak() noexcept { __atomic_fetch_add(&weak, 1, __ATOMIC_RELAXED); }
  bool add_shared_if_live() noexcept {  // weak_ptr::lock: CAS loop, never resurrects 0
    long n = __atomic_load_n(&shared, __ATOMIC_RELAXED);
    while (n != 0)
      if (__atomic_compare_exchange_n(&shared, &n, n + 1, true, __ATOMIC_ACQ_REL, __ATOMIC_RELAXED)) return true;
    return false;
  }
  void release_shared() noexcept {
    if (__atomic_fetch_sub(&shared, 1, __ATOMIC_RELEASE) == 1) {
      __atomic_thread_fence(__ATOMIC_ACQUIRE);
      dispose();
      release_weak();
    }
  }
  void release_weak() noexcept {
    if (__atomic_fetch_sub(&weak, 1, __ATOMIC_RELEASE) == 1) {
      __atomic_thread_fence(__ATOMIC_ACQUIRE);
      destroy();
    }
  }
  long use_count() const noexcept { return __atomic_load_n(&shared, __ATOMIC_RELAXED); }
 protected:
  ~ctrl() = default;
};
template <class P, class D> struct ctrl_ptr final : ctrl {
  P p;
  [[no_unique_address]] D d;
  ctrl_ptr(P p_, D d_) : p(p_), d(std::move(d_)) {}
  void dispose() noexcept override { d(p); }
  void destroy() noexcept override { delete this; }
  void* get_deleter(const type_info& ti) noexcept override { return ti == typeid(D) ? addressof(d) : nullptr; }
};
template <class T> struct ctrl_inplace final : ctrl {
  alignas(T) unsigned char buf[sizeof(T)];
  T* ptr() noexcept { return reinterpret_cast<T*>(buf); }
  void dispose() noexcept override { std::destroy_at(ptr()); }
  void destroy() noexcept override { delete this; }
};
}  // namespace __lk

