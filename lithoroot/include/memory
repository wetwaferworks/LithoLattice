template <class T>
class shared_ptr {
 public:
  using element_type = remove_extent_t<T>;
  using weak_type = weak_ptr<T>;
  constexpr shared_ptr() noexcept = default;
  constexpr shared_ptr(nullptr_t) noexcept {}
  template <class Y, class = enable_if_t<is_convertible_v<Y*, element_type*>>>
  explicit shared_ptr(Y* p) {
    using Del = conditional_t<is_array_v<T>, default_delete<Y[]>, default_delete<Y>>;
    try { c_ = new __lk::ctrl_ptr<Y*, Del>(p, Del()); } catch (...) { Del()(p); throw; }
    p_ = p;
    enable_weak(p);
  }
  template <class Y, class D, class = enable_if_t<is_convertible_v<Y*, element_type*>>>
  shared_ptr(Y* p, D d) {
    try { c_ = new __lk::ctrl_ptr<Y*, D>(p, d); } catch (...) { d(p); throw; }
    p_ = p;
    enable_weak(p);
  }
  template <class D> shared_ptr(nullptr_t, D d) {
    try { c_ = new __lk::ctrl_ptr<nullptr_t, D>(nullptr, d); } catch (...) { d(nullptr); throw; }
  }
  template <class Y> shared_ptr(const shared_ptr<Y>& r, element_type* p) noexcept : p_(p), c_(r.c_) { if (c_) c_->add_shared(); }
  template <class Y> shared_ptr(shared_ptr<Y>&& r, element_type* p) noexcept : p_(p), c_(r.c_) { r.p_ = nullptr; r.c_ = nullptr; }
  shared_ptr(const shared_ptr& r) noexcept : p_(r.p_), c_(r.c_) { if (c_) c_->add_shared(); }
  template <class Y, class = enable_if_t<is_convertible_v<Y*, element_type*>>>
  shared_ptr(const shared_ptr<Y>& r) noexcept : p_(r.p_), c_(r.c_) { if (c_) c_->add_shared(); }
  shared_ptr(shared_ptr&& r) noexcept : p_(r.p_), c_(r.c_) { r.p_ = nullptr; r.c_ = nullptr; }
  template <class Y, class = enable_if_t<is_convertible_v<Y*, element_type*>>>
  shared_ptr(shared_ptr<Y>&& r) noexcept : p_(r.p_), c_(r.c_) { r.p_ = nullptr; r.c_ = nullptr; }
  template <class Y, class = enable_if_t<is_convertible_v<Y*, element_type*>>>
  explicit shared_ptr(const weak_ptr<Y>& r) {
    if (!r.c_ || !r.c_->add_shared_if_live()) throw bad_weak_ptr();
    c_ = r.c_; p_ = r.p_;
  }
  template <class Y, class D, class = enable_if_t<is_convertible_v<typename unique_ptr<Y, D>::pointer, element_type*>>>
  shared_ptr(unique_ptr<Y, D>&& u) {
    if (!u) return;
    using DD = conditional_t<is_reference_v<D>, reference_wrapper_lk<remove_reference_t<D>>, D>;
    auto* raw = u.get();
    c_ = new __lk::ctrl_ptr<typename unique_ptr<Y, D>::pointer, DD>(raw, DD(u.get_deleter()));
    u.release();
    p_ = raw;
    enable_weak(raw);
  }
  ~shared_ptr() { if (c_) c_->release_shared(); }
  shared_ptr& operator=(const shared_ptr& r) noexcept { shared_ptr(r).swap(*this); return *this; }
  template <class Y> shared_ptr& operator=(const shared_ptr<Y>& r) noexcept { shared_ptr(r).swap(*this); return *this; }
  shared_ptr& operator=(shared_ptr&& r) noexcept { shared_ptr(std::move(r)).swap(*this); return *this; }
  template <class Y> shared_ptr& operator=(shared_ptr<Y>&& r) noexcept { shared_ptr(std::move(r)).swap(*this); return *this; }
  template <class Y, class D> shared_ptr& operator=(unique_ptr<Y, D>&& u) { shared_ptr(std::move(u)).swap(*this); return *this; }
  void reset() noexcept { shared_ptr().swap(*this); }
  template <class Y> void reset(Y* p) { shared_ptr(p).swap(*this); }
  template <class Y, class D> void reset(Y* p, D d) { shared_ptr(p, d).swap(*this); }
  void swap(shared_ptr& r) noexcept { std::swap(p_, r.p_); std::swap(c_, r.c_); }
  element_type* get() const noexcept { return p_; }
  template <class U = T, enable_if_t<!is_void_v<U> && !is_array_v<U>, int> = 0> add_lvalue_reference_t<U> operator*() const noexcept { return *p_; }
  template <class U = T, enable_if_t<!is_array_v<U>, int> = 0> element_type* operator->() const noexcept { return p_; }
  template <class U = T, enable_if_t<is_array_v<U>, int> = 0> remove_extent_t<U>& operator[](ptrdiff_t i) const { return p_[i]; }
  long use_count() const noexcept { return c_ ? c_->use_count() : 0; }
  explicit operator bool() const noexcept { return p_ != nullptr; }
  template <class U> bool owner_before(const shared_ptr<U>& o) const noexcept { return c_ < o.c_; }
  template <class U> bool owner_before(const weak_ptr<U>& o) const noexcept { return c_ < o.c_; }

 private:
  template <class U> struct reference_wrapper_lk {  // deleter held by reference (unique_ptr<T, D&>)
    U* d;
    reference_wrapper_lk(U& u) : d(addressof(u)) {}
    template <class P> void operator()(P p) const { (*d)(p); }
  };
  template <class Y> void enable_weak(Y* p) noexcept {
    if constexpr (__lk::has_esft<Y>::value) {
      if (p && p->__lk_weak_this.expired()) p->__lk_weak_this = shared_ptr<remove_cv_t<Y>>(*this, const_cast<remove_cv_t<Y>*>(p));
    }
  }
  template <class U> friend class shared_ptr;
  template <class U> friend class weak_ptr;
  template <class U, class... A> friend shared_ptr<U> make_shared(A&&...);
  template <class D, class U> friend D* get_deleter(const shared_ptr<U>&) noexcept;
  element_type* p_ = nullptr;
  __lk::ctrl* c_ = nullptr;
};

template <class T, class... A>
shared_ptr<T> make_shared(A&&... a) {
  static_assert(!is_array_v<T>, "LithoRoot: make_shared<T[]> is not provided (plan L3; add when a TU needs it)");
  auto* c = new __lk::ctrl_inplace<T>;
  try { std::construct_at(c->ptr(), std::forward<A>(a)...); } catch (...) { delete c; throw; }
  shared_ptr<T> r;
  r.c_ = c;
  r.p_ = c->ptr();
  r.enable_weak(r.p_);
  return r;
}

template <class T>
class weak_ptr {
 public:
  using element_type = remove_extent_t<T>;
  constexpr weak_ptr() noexcept = default;
  weak_ptr(const weak_ptr& r) noexcept : p_(r.p_), c_(r.c_) { if (c_) c_->add_weak(); }
  template <class Y, class = enable_if_t<is_convertible_v<Y*, element_type*>>>
  weak_ptr(const weak_ptr<Y>& r) noexcept : c_(r.c_) { if (c_) { c_->add_weak(); p_ = r.lock().get(); } }
  template <class Y, class = enable_if_t<is_convertible_v<Y*, element_type*>>>
  weak_ptr(const shared_ptr<Y>& r) noexcept : p_(r.p_), c_(r.c_) { if (c_) c_->add_weak(); }
  weak_ptr(weak_ptr&& r) noexcept : p_(r.p_), c_(r.c_) { r.p_ = nullptr; r.c_ = nullptr; }
  ~weak_ptr() { if (c_) c_->release_weak(); }
  weak_ptr& operator=(const weak_ptr& r) noexcept { weak_ptr(r).swap(*this); return *this; }
  template <class Y> weak_ptr& operator=(const shared_ptr<Y>& r) noexcept { weak_ptr(r).swap(*this); return *this; }
  weak_ptr& operator=(weak_ptr&& r) noexcept { weak_ptr(std::move(r)).swap(*this); return *this; }
  void reset() noexcept { weak_ptr().swap(*this); }
  void swap(weak_ptr& r) noexcept { std::swap(p_, r.p_); std::swap(c_, r.c_); }
  long use_count() const noexcept { return c_ ? c_->use_count() : 0; }
  bool expired() const noexcept { return use_count() == 0; }
  shared_ptr<T> lock() const noexcept {
    shared_ptr<T> r;
    if (c_ && c_->add_shared_if_live()) { r.c_ = c_; r.p_ = p_; }
    return r;
  }
  template <class U> bool owner_before(const weak_ptr<U>& o) const noexcept { return c_ < o.c_; }
  template <class U> bool owner_before(const shared_ptr<U>& o) const noexcept { return c_ < o.c_; }
 private:
  template <class U> friend class shared_ptr;
  template <class U> friend class weak_ptr;
  element_type* p_ = nullptr;
  __lk::ctrl* c_ = nullptr;
};

template <class T>
class enable_shared_from_this {
 public:
  shared_ptr<T> shared_from_this() { return shared_ptr<T>(__lk_weak_this); }
  shared_ptr<const T> shared_from_this() const { return shared_ptr<const T>(__lk_weak_this); }
  weak_ptr<T> weak_from_this() noexcept { return __lk_weak_this; }
  weak_ptr<const T> weak_from_this() const noexcept { return __lk_weak_this; }
 protected:
  constexpr enable_shared_from_this() noexcept = default;
  enable_shared_from_this(const enable_shared_from_this&) noexcept {}
  enable_shared_from_this& operator=(const enable_shared_from_this&) noexcept { return *this; }
  ~enable_shared_from_this() = default;
 public:
  mutable weak_ptr<T> __lk_weak_this;  // reserved name; set by shared_ptr's constructors
};

template <class T> void swap(shared_ptr<T>& a, shared_ptr<T>& b) noexcept { a.swap(b); }
template <class T> void swap(weak_ptr<T>& a, weak_ptr<T>& b) noexcept { a.swap(b); }
template <class T, class U> bool operator==(const shared_ptr<T>& a, const shared_ptr<U>& b) noexcept { return a.get() == b.get(); }
template <class T, class U> bool operator<(const shared_ptr<T>& a, const shared_ptr<U>& b) noexcept { return a.get() < b.get(); }
template <class T> bool operator==(const shared_ptr<T>& a, nullptr_t) noexcept { return !a; }

template <class T, class U> shared_ptr<T> static_pointer_cast(const shared_ptr<U>& r) noexcept {
  return shared_ptr<T>(r, static_cast<typename shared_ptr<T>::element_type*>(r.get()));
}
template <class T, class U> shared_ptr<T> const_pointer_cast(const shared_ptr<U>& r) noexcept {
  return shared_ptr<T>(r, const_cast<typename shared_ptr<T>::element_type*>(r.get()));
}
template <class T, class U> shared_ptr<T> reinterpret_pointer_cast(const shared_ptr<U>& r) noexcept {
  return shared_ptr<T>(r, reinterpret_cast<typename shared_ptr<T>::element_type*>(r.get()));
}
template <class T, class U> shared_ptr<T> dynamic_pointer_cast(const shared_ptr<U>& r) noexcept {
  if (auto* p = dynamic_cast<typename shared_ptr<T>::element_type*>(r.get())) return shared_ptr<T>(r, p);
  return shared_ptr<T>();
}
template <class D, class T> D* get_deleter(const shared_ptr<T>& p) noexcept {
  return p.c_ ? static_cast<D*>(p.c_->get_deleter(typeid(D))) : nullptr;
}

template <class T = void> struct owner_less {
  template <class A, class B> bool operator()(const A& a, const B& b) const noexcept { return a.owner_before(b); }
};

