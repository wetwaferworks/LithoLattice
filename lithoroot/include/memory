/* ---- pointer_traits / to_address ---- */
template <class P> struct pointer_traits {
  using pointer = P;
  using element_type = typename P::element_type;
  using difference_type = ptrdiff_t;
};
template <class T> struct pointer_traits<T*> {
  using pointer = T*;
  using element_type = T;
  using difference_type = ptrdiff_t;
  template <class U> using rebind = U*;
  static constexpr T* pointer_to(conditional_t<is_void_v<T>, char, T>& r) noexcept { return addressof(r); }
};
template <class T> constexpr T* to_address(T* p) noexcept {
  static_assert(!is_function_v<T>, "to_address of a function pointer");
  return p;
}
template <class P> constexpr auto to_address(const P& p) noexcept { return std::to_address(p.operator->()); }

/* ---- construct / destroy ---- */
template <class T, class... A>
constexpr T* construct_at(T* p, A&&... a) { return ::new (const_cast<void*>(static_cast<const volatile void*>(p))) T(std::forward<A>(a)...); }
template <class T> constexpr void destroy_at(T* p) {
  if constexpr (is_array_v<T>) { for (auto& e : *p) std::destroy_at(addressof(e)); }
  else p->~T();
}
template <class I> constexpr void destroy(I first, I last) { for (; first != last; ++first) std::destroy_at(addressof(*first)); }
template <class I, class N> constexpr I destroy_n(I first, N n) { for (; n > 0; (void)++first, --n) std::destroy_at(addressof(*first)); return first; }

/* ---- uninitialized algorithms (strong guarantee: roll back on throw) ---- */
#define LR_VOIDP(it) static_cast<void*>(addressof(*(it)))
template <class I, class O> O uninitialized_copy(I first, I last, O out) {
  O cur = out;
  try { for (; first != last; ++first, (void)++cur) ::new (LR_VOIDP(cur)) iter_value_t<O>(*first); }
  catch (...) { std::destroy(out, cur); throw; }
  return cur;
}
template <class I, class N, class O> O uninitialized_copy_n(I first, N n, O out) {
  O cur = out;
  try { for (; n > 0; ++first, (void)++cur, --n) ::new (LR_VOIDP(cur)) iter_value_t<O>(*first); }
  catch (...) { std::destroy(out, cur); throw; }
  return cur;
}
template <class I, class O> O uninitialized_move(I first, I last, O out) {
  O cur = out;
  try { for (; first != last; ++first, (void)++cur) ::new (LR_VOIDP(cur)) iter_value_t<O>(std::move(*first)); }
  catch (...) { std::destroy(out, cur); throw; }
  return cur;
}
template <class I, class N, class O> pair<I, O> uninitialized_move_n(I first, N n, O out) {
  O cur = out;
  try { for (; n > 0; ++first, (void)++cur, --n) ::new (LR_VOIDP(cur)) iter_value_t<O>(std::move(*first)); }
  catch (...) { std::destroy(out, cur); throw; }
  return {first, cur};
}
template <class O, class T> void uninitialized_fill(O first, O last, const T& v) {
  O cur = first;
  try { for (; cur != last; ++cur) ::new (LR_VOIDP(cur)) iter_value_t<O>(v); }
  catch (...) { std::destroy(first, cur); throw; }
}
template <class O, class N, class T> O uninitialized_fill_n(O first, N n, const T& v) {
  O cur = first;
  try { for (; n > 0; ++cur, (void)--n) ::new (LR_VOIDP(cur)) iter_value_t<O>(v); }
  catch (...) { std::destroy(first, cur); throw; }
  return cur;
}
template <class O> void uninitialized_value_construct(O first, O last) {
  O cur = first;
  try { for (; cur != last; ++cur) ::new (LR_VOIDP(cur)) iter_value_t<O>(); }
  catch (...) { std::destroy(first, cur); throw; }
}
template <class O, class N> O uninitialized_value_construct_n(O first, N n) {
  O cur = first;
  try { for (; n > 0; ++cur, (void)--n) ::new (LR_VOIDP(cur)) iter_value_t<O>(); }
  catch (...) { std::destroy(first, cur); throw; }
  return cur;
}
template <class O> void uninitialized_default_construct(O first, O last) {
  O cur = first;
  try { for (; cur != last; ++cur) ::new (LR_VOIDP(cur)) iter_value_t<O>; }
  catch (...) { std::destroy(first, cur); throw; }
}
template <class O, class N> O uninitialized_default_construct_n(O first, N n) {
  O cur = first;
  try { for (; n > 0; ++cur, (void)--n) ::new (LR_VOIDP(cur)) iter_value_t<O>; }
  catch (...) { std::destroy(first, cur); throw; }
  return cur;
}
#undef LR_VOIDP

/* ---- allocator ---- */
template <class T>
class allocator {
 public:
  using value_type = T;
  using size_type = size_t;
  using difference_type = ptrdiff_t;
  using propagate_on_container_move_assignment = true_type;
  using is_always_equal = true_type;
  template <class U> struct rebind { using other = allocator<U>; };
  constexpr allocator() noexcept = default;
  template <class U> constexpr allocator(const allocator<U>&) noexcept {}
  [[nodiscard]] T* allocate(size_t n) {
    if (n > size_t(-1) / sizeof(T)) throw bad_array_new_length();
    if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__)
      return static_cast<T*>(::operator new(n * sizeof(T), align_val_t(alignof(T))));
    else
      return static_cast<T*>(::operator new(n * sizeof(T)));
  }
  void deallocate(T* p, size_t n) noexcept {
    if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__)
      ::operator delete(p, n * sizeof(T), align_val_t(alignof(T)));
    else
      ::operator delete(p, n * sizeof(T));
  }
};
template <class T, class U> constexpr bool operator==(const allocator<T>&, const allocator<U>&) noexcept { return true; }

