/* Free functions (the census uses the _explicit forms). */
template <class T> T atomic_load(const atomic<T>* a) noexcept { return a->load(); }
template <class T> T atomic_load_explicit(const atomic<T>* a, memory_order m) noexcept { return a->load(m); }
template <class T> void atomic_store(atomic<T>* a, typename atomic<T>::value_type d) noexcept { a->store(d); }
template <class T> void atomic_store_explicit(atomic<T>* a, typename atomic<T>::value_type d, memory_order m) noexcept { a->store(d, m); }
template <class T> T atomic_exchange_explicit(atomic<T>* a, typename atomic<T>::value_type d, memory_order m) noexcept { return a->exchange(d, m); }
template <class T> bool atomic_compare_exchange_weak_explicit(atomic<T>* a, typename atomic<T>::value_type* e, typename atomic<T>::value_type d, memory_order s, memory_order f) noexcept { return a->compare_exchange_weak(*e, d, s, f); }
template <class T> bool atomic_compare_exchange_strong_explicit(atomic<T>* a, typename atomic<T>::value_type* e, typename atomic<T>::value_type d, memory_order s, memory_order f) noexcept { return a->compare_exchange_strong(*e, d, s, f); }
template <class T> T atomic_fetch_add_explicit(atomic<T>* a, typename atomic<T>::difference_type d, memory_order m) noexcept { return a->fetch_add(d, m); }
