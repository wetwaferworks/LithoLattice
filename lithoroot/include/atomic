/* atomic ... LithoRoot std L8 (S4, 2026-11-16, plan 3.4): std::atomic over
 * clang's __atomic builtins only. wasm32 with -matomics has native lock-free
 * 8/16/32/64-bit atomics, so every atomic here is lock-free; T larger than 8
 * bytes is a compile error (no lock-based fallback, ever). 8-byte T is
 * forced to 8-byte alignment.
 *
 * wait/notify (plan 3.4, rule 1): memory.atomic.wait32 traps on the page
 * thread and on unshared memory (single-thread mode), so atomic::wait only
 * blocks when the runtime says this thread may: the weak hook
 * __lk_can_block_here(), which LithoWeave answers 1 on spawned workers (S5). Without it,
 * wait spins a bounded number of rechecks, and if the value still has not
 * changed it reports the design bug once through lithosys_console_write and
 * returns: it never traps and never blocks the page. Callers loop on their
 * condition, as every engine call site already does. */
#ifndef LITHOROOT_ATOMIC
#define LITHOROOT_ATOMIC
#if !defined(__wasm__)
#error "LithoRoot std headers are wasm32-only; native builds use their own C++ library"
#endif
#include <cstddef>
#include <cstdint>
#include <type_traits>
#include <lithosys.h>

extern "C" int __lk_can_block_here(void) __attribute__((weak));  // LithoWeave (S5): 1 on spawned workers; absent = never block

namespace std {

enum class memory_order : int {
  relaxed = __ATOMIC_RELAXED, consume = __ATOMIC_CONSUME, acquire = __ATOMIC_ACQUIRE,
  release = __ATOMIC_RELEASE, acq_rel = __ATOMIC_ACQ_REL, seq_cst = __ATOMIC_SEQ_CST
};
inline constexpr memory_order memory_order_relaxed = memory_order::relaxed;
inline constexpr memory_order memory_order_consume = memory_order::consume;
inline constexpr memory_order memory_order_acquire = memory_order::acquire;
inline constexpr memory_order memory_order_release = memory_order::release;
inline constexpr memory_order memory_order_acq_rel = memory_order::acq_rel;
inline constexpr memory_order memory_order_seq_cst = memory_order::seq_cst;

inline void atomic_thread_fence(memory_order m) noexcept { __atomic_thread_fence(int(m)); }
inline void atomic_signal_fence(memory_order m) noexcept { __atomic_signal_fence(int(m)); }
template <class T> T kill_dependency(T y) noexcept { return y; }

#define ATOMIC_BOOL_LOCK_FREE 2
#define ATOMIC_CHAR_LOCK_FREE 2
#define ATOMIC_SHORT_LOCK_FREE 2
#define ATOMIC_INT_LOCK_FREE 2
#define ATOMIC_LONG_LOCK_FREE 2
#define ATOMIC_LLONG_LOCK_FREE 2
#define ATOMIC_POINTER_LOCK_FREE 2

namespace __lk {
constexpr int fail_order(memory_order m) noexcept {  // the failure order may not release
  return m == memory_order::acq_rel ? __ATOMIC_ACQUIRE : m == memory_order::release ? __ATOMIC_RELAXED : int(m);
}
inline bool can_block() noexcept { return &__lk_can_block_here != nullptr && __lk_can_block_here() != 0; }
inline void report_wait_bug() noexcept {
  static int once = 0;
  if (__atomic_exchange_n(&once, 1, __ATOMIC_RELAXED) == 0) {
    static const char msg[] = "LithoRoot: atomic::wait on a thread that may not block (page / single-thread); returned after a bounded spin\n";
    lithosys_console_write(msg, sizeof msg - 1);
  }
}
/* The 32-bit word holding the first byte of an object (wait32 needs 4-byte alignment). */
inline int32_t* wait_word(const void* p) noexcept { return reinterpret_cast<int32_t*>(reinterpret_cast<uintptr_t>(p) & ~uintptr_t(3)); }
template <class T> bool same_bits(const T& a, const T& b) noexcept { return __builtin_memcmp(&a, &b, sizeof(T)) == 0; }

template <class T> struct atomic_base {
  static_assert(__is_trivially_copyable(T), "std::atomic<T> requires a trivially copyable T");
  static_assert(sizeof(T) <= 8, "LithoRoot: atomics wider than 8 bytes would need a lock; none is provided (JD t42u)");
  static constexpr size_t req_align = (sizeof(T) & (sizeof(T) - 1)) == 0 && sizeof(T) > alignof(T) ? sizeof(T) : alignof(T);
  alignas(req_align) T v_;

  static constexpr bool is_always_lock_free = true;
  constexpr atomic_base() noexcept(is_nothrow_default_constructible_v<T>) : v_() {}
  constexpr atomic_base(T d) noexcept : v_(d) {}
  atomic_base(const atomic_base&) = delete;
  atomic_base& operator=(const atomic_base&) = delete;
  atomic_base& operator=(const atomic_base&) volatile = delete;

  bool is_lock_free() const noexcept { return true; }
  void store(T d, memory_order m = memory_order::seq_cst) noexcept { __atomic_store(&v_, &d, int(m)); }
  T load(memory_order m = memory_order::seq_cst) const noexcept { alignas(req_align) T r; __atomic_load(&v_, &r, int(m)); return r; }
  operator T() const noexcept { return load(); }
  T exchange(T d, memory_order m = memory_order::seq_cst) noexcept { alignas(req_align) T r; __atomic_exchange(&v_, &d, &r, int(m)); return r; }
  bool compare_exchange_weak(T& e, T d, memory_order s, memory_order f) noexcept { return __atomic_compare_exchange(&v_, &e, &d, true, int(s), int(f)); }
  bool compare_exchange_strong(T& e, T d, memory_order s, memory_order f) noexcept { return __atomic_compare_exchange(&v_, &e, &d, false, int(s), int(f)); }
  bool compare_exchange_weak(T& e, T d, memory_order m = memory_order::seq_cst) noexcept { return __atomic_compare_exchange(&v_, &e, &d, true, int(m), fail_order(m)); }
  bool compare_exchange_strong(T& e, T d, memory_order m = memory_order::seq_cst) noexcept { return __atomic_compare_exchange(&v_, &e, &d, false, int(m), fail_order(m)); }

  void wait(T old, memory_order m = memory_order::seq_cst) const noexcept {
    for (int spin = 0; spin < 4096; ++spin) {
      if (!same_bits(load(m), old)) return;
    }
    if (!can_block()) {
      for (int spin = 0; spin < (1 << 20); ++spin) if (!same_bits(load(m), old)) return;
      report_wait_bug();
      return;
    }
    int32_t* w = wait_word(&v_);
    while (same_bits(load(m), old)) {
      const int32_t cur = __atomic_load_n(w, __ATOMIC_SEQ_CST);
      if (!same_bits(load(m), old)) return;  // recheck after reading the word: no lost wake-up
      __builtin_wasm_memory_atomic_wait32(w, cur, 1000000);  // 1 ms cap: an 8-byte T may change only its high word
    }
  }
  void notify_one() noexcept { __builtin_wasm_memory_atomic_notify(wait_word(&v_), 1); }
  void notify_all() noexcept { __builtin_wasm_memory_atomic_notify(wait_word(&v_), ~0u); }
};

template <class T> struct atomic_int : atomic_base<T> {
  using atomic_base<T>::atomic_base;
  using difference_type = T;
  T fetch_add(T d, memory_order m = memory_order::seq_cst) noexcept { return __atomic_fetch_add(&this->v_, d, int(m)); }
  T fetch_sub(T d, memory_order m = memory_order::seq_cst) noexcept { return __atomic_fetch_sub(&this->v_, d, int(m)); }
  T fetch_and(T d, memory_order m = memory_order::seq_cst) noexcept { return __atomic_fetch_and(&this->v_, d, int(m)); }
  T fetch_or(T d, memory_order m = memory_order::seq_cst) noexcept { return __atomic_fetch_or(&this->v_, d, int(m)); }
  T fetch_xor(T d, memory_order m = memory_order::seq_cst) noexcept { return __atomic_fetch_xor(&this->v_, d, int(m)); }
  T operator++(int) noexcept { return fetch_add(1); }
  T operator--(int) noexcept { return fetch_sub(1); }
  T operator++() noexcept { return __atomic_add_fetch(&this->v_, T(1), __ATOMIC_SEQ_CST); }
  T operator--() noexcept { return __atomic_sub_fetch(&this->v_, T(1), __ATOMIC_SEQ_CST); }
  T operator+=(T d) noexcept { return __atomic_add_fetch(&this->v_, d, __ATOMIC_SEQ_CST); }
  T operator-=(T d) noexcept { return __atomic_sub_fetch(&this->v_, d, __ATOMIC_SEQ_CST); }
  T operator&=(T d) noexcept { return __atomic_and_fetch(&this->v_, d, __ATOMIC_SEQ_CST); }
  T operator|=(T d) noexcept { return __atomic_or_fetch(&this->v_, d, __ATOMIC_SEQ_CST); }
  T operator^=(T d) noexcept { return __atomic_xor_fetch(&this->v_, d, __ATOMIC_SEQ_CST); }
  T operator=(T d) noexcept { this->store(d); return d; }
};
template <class T> struct atomic_float : atomic_base<T> {
  using atomic_base<T>::atomic_base;
  using difference_type = T;
  /* No float RMW instruction: a CAS loop on the value (bit-exact, lock-free). */
  T fetch_add(T d, memory_order m = memory_order::seq_cst) noexcept {
    T old = this->load(memory_order::relaxed);
    while (!this->compare_exchange_weak(old, old + d, m, memory_order::relaxed)) {}
    return old;
  }
  T fetch_sub(T d, memory_order m = memory_order::seq_cst) noexcept {
    T old = this->load(memory_order::relaxed);
    while (!this->compare_exchange_weak(old, old - d, m, memory_order::relaxed)) {}
    return old;
  }
  T operator+=(T d) noexcept { return fetch_add(d) + d; }
  T operator-=(T d) noexcept { return fetch_sub(d) - d; }
  T operator=(T d) noexcept { this->store(d); return d; }
};
template <class T> struct atomic_ptr : atomic_base<T*> {
  using atomic_base<T*>::atomic_base;
  using difference_type = ptrdiff_t;
  T* fetch_add(ptrdiff_t d, memory_order m = memory_order::seq_cst) noexcept { return __atomic_fetch_add(&this->v_, d * ptrdiff_t(sizeof(T)), int(m)); }
  T* fetch_sub(ptrdiff_t d, memory_order m = memory_order::seq_cst) noexcept { return __atomic_fetch_sub(&this->v_, d * ptrdiff_t(sizeof(T)), int(m)); }
  T* operator++(int) noexcept { return fetch_add(1); }
  T* operator--(int) noexcept { return fetch_sub(1); }
  T* operator++() noexcept { return fetch_add(1) + 1; }
  T* operator--() noexcept { return fetch_sub(1) - 1; }
  T* operator+=(ptrdiff_t d) noexcept { return fetch_add(d) + d; }
  T* operator-=(ptrdiff_t d) noexcept { return fetch_sub(d) - d; }
  T* operator=(T* d) noexcept { this->store(d); return d; }
};
template <class T> struct atomic_plain : atomic_base<T> {
  using atomic_base<T>::atomic_base;
  T operator=(T d) noexcept { this->store(d); return d; }
};
template <class T> using atomic_select =
    conditional_t<is_integral_v<T> && !is_same_v<T, bool>, atomic_int<T>,
                  conditional_t<is_floating_point_v<T>, atomic_float<T>, atomic_plain<T>>>;
}  // namespace __lk

template <class T> struct atomic : __lk::atomic_select<T> {
  using value_type = T;
  using __lk::atomic_select<T>::atomic_select;
  using __lk::atomic_select<T>::operator=;
  constexpr atomic() noexcept(is_nothrow_default_constructible_v<T>) = default;
};
template <class T> struct atomic<T*> : __lk::atomic_ptr<T> {
  using value_type = T*;
  using __lk::atomic_ptr<T>::atomic_ptr;
  using __lk::atomic_ptr<T>::operator=;
  constexpr atomic() noexcept = default;
};

/* LithoRoot provides no atomic<shared_ptr> (plan 1.3: every implementation hides a lock). */
template <class T> class shared_ptr;
template <class T> struct atomic<shared_ptr<T>>;

struct atomic_flag {
  bool v_ = false;
  constexpr atomic_flag() noexcept = default;
  atomic_flag(const atomic_flag&) = delete;
  atomic_flag& operator=(const atomic_flag&) = delete;
  bool test(memory_order m = memory_order::seq_cst) const noexcept { return __atomic_load_n(&v_, int(m)); }
  bool test_and_set(memory_order m = memory_order::seq_cst) noexcept { return __atomic_test_and_set(&v_, int(m)); }
  void clear(memory_order m = memory_order::seq_cst) noexcept { __atomic_clear(&v_, int(m)); }
};
