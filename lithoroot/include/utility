namespace std {

template <class T> [[nodiscard]] constexpr remove_reference_t<T>&& move(T&& t) noexcept { return static_cast<remove_reference_t<T>&&>(t); }
template <class T> [[nodiscard]] constexpr T&& forward(remove_reference_t<T>& t) noexcept { return static_cast<T&&>(t); }
template <class T> [[nodiscard]] constexpr T&& forward(remove_reference_t<T>&& t) noexcept {
  static_assert(!is_lvalue_reference_v<T>, "std::forward: cannot forward an rvalue as an lvalue");
  return static_cast<T&&>(t);
}
template <class T>
[[nodiscard]] constexpr conditional_t<!is_nothrow_move_constructible_v<T> && is_copy_constructible_v<T>, const T&, T&&>
move_if_noexcept(T& x) noexcept { return std::move(x); }
template <class T> [[nodiscard]] constexpr add_const_t<T>& as_const(T& t) noexcept { return t; }
template <class T> void as_const(const T&&) = delete;
template <class T> [[nodiscard]] constexpr T* addressof(T& r) noexcept { return __builtin_addressof(r); }
template <class T> const T* addressof(const T&&) = delete;

template <class T>
constexpr enable_if_t<is_move_constructible_v<T> && is_move_assignable_v<T>>
swap(T& a, T& b) noexcept(is_nothrow_move_constructible_v<T> && is_nothrow_move_assignable_v<T>) {
  T t(std::move(a)); a = std::move(b); b = std::move(t);
}
template <class T, size_t N>
constexpr void swap(T (&a)[N], T (&b)[N]) noexcept(noexcept(swap(*a, *b))) {
  for (size_t i = 0; i < N; ++i) swap(a[i], b[i]);
}
template <class T, class U = T>
constexpr T exchange(T& obj, U&& v) noexcept(is_nothrow_move_constructible_v<T> && is_nothrow_assignable_v<T&, U>) {
  T old = std::move(obj); obj = std::forward<U>(v); return old;
}

namespace __lk {
using std::swap;
template <class T, class U, class = void> struct swappable_with : false_type {};
template <class T, class U>
struct swappable_with<T, U, void_t<decltype(swap(declval<T>(), declval<U>())), decltype(swap(declval<U>(), declval<T>()))>> : true_type {};
template <class T, class U, bool = swappable_with<T, U>::value> struct nt_swappable_with : false_type {};
template <class T, class U>
struct nt_swappable_with<T, U, true> : bool_constant<noexcept(swap(declval<T>(), declval<U>())) && noexcept(swap(declval<U>(), declval<T>()))> {};
}  // namespace __lk
template <class T, class U> struct is_swappable_with : __lk::swappable_with<T, U> {};
template <class T> struct is_swappable : __lk::swappable_with<add_lvalue_reference_t<T>, add_lvalue_reference_t<T>> {};
template <class T> struct is_nothrow_swappable : __lk::nt_swappable_with<add_lvalue_reference_t<T>, add_lvalue_reference_t<T>> {};
template <class T, class U> inline constexpr bool is_swappable_with_v = is_swappable_with<T, U>::value;
template <class T> inline constexpr bool is_swappable_v = is_swappable<T>::value;
template <class T> inline constexpr bool is_nothrow_swappable_v = is_nothrow_swappable<T>::value;

template <class T, T... I> struct integer_sequence {
  using value_type = T;
  static constexpr size_t size() noexcept { return sizeof...(I); }
};
template <size_t... I> using index_sequence = integer_sequence<size_t, I...>;
template <class T, T N> using make_integer_sequence = __make_integer_seq<integer_sequence, T, N>;
template <size_t N> using make_index_sequence = make_integer_sequence<size_t, N>;
template <class... T> using index_sequence_for = make_index_sequence<sizeof...(T)>;

