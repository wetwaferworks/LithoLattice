/* cmath ... LithoRoot std L2 (S2, 2026-11-16). <math.h> lifted into std
 * with the float overloads the standard requires: std::sqrt(float) calls
 * sqrtf and so on, so float code stays float on web instead of silently
 * promoting to double. Only functions LithoLibC implements are lifted;
 * a missing one fails at compile time (census), never at run time.
 * long double overloads are not provided (wasm32 long double is soft
 * binary128; the tree does not use it). */
#ifndef LITHOROOT_CMATH
#define LITHOROOT_CMATH
#if !defined(__wasm__)
#error "LithoRoot std headers are wasm32-only; native builds use their own C++ library"
#endif
#include <cstdlib>  /* std::abs(int/long/long long), as the standard has <cmath> declare them too */
#include <math.h>
#include <type_traits>
#undef fpclassify
#undef isnan
#undef isinf
#undef isfinite
#undef isnormal
#undef signbit

