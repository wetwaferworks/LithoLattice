template <class I, enable_if_t<is_integral_v<I>, int> = 0> inline bool isnan(I) noexcept { return false; }
template <class I, enable_if_t<is_integral_v<I>, int> = 0> inline bool isinf(I) noexcept { return false; }
template <class I, enable_if_t<is_integral_v<I>, int> = 0> inline bool isfinite(I) noexcept { return true; }

/* Integer arguments take the double overloads, as the standard says. */
#define LR_INT_TO_DOUBLE(n) template <class I, enable_if_t<is_integral_v<I>, int> = 0> inline double n(I x) noexcept { return ::n(double(x)); }
LR_INT_TO_DOUBLE(sqrt) LR_INT_TO_DOUBLE(floor) LR_INT_TO_DOUBLE(ceil) LR_INT_TO_DOUBLE(exp) LR_INT_TO_DOUBLE(log)
LR_INT_TO_DOUBLE(log2) LR_INT_TO_DOUBLE(log10) LR_INT_TO_DOUBLE(sin) LR_INT_TO_DOUBLE(cos) LR_INT_TO_DOUBLE(fabs)
#undef LR_INT_TO_DOUBLE
template <class A, class B, enable_if_t<is_arithmetic_v<A> && is_arithmetic_v<B> && !(is_same_v<A, B> && is_floating_point_v<A>), int> = 0>
inline auto pow(A a, B b) noexcept {
  using R = conditional_t<is_same_v<A, float> && is_same_v<B, float>, float, double>;
  if constexpr (is_same_v<R, float>) return ::powf(a, b); else return ::pow(double(a), double(b));
}
template <class A, class B, enable_if_t<is_arithmetic_v<A> && is_arithmetic_v<B> && !(is_same_v<A, B> && is_floating_point_v<A>), int> = 0>
inline double atan2(A a, B b) noexcept { return ::atan2(double(a), double(b)); }
template <class A, class B, enable_if_t<is_arithmetic_v<A> && is_arithmetic_v<B> && !(is_same_v<A, B> && is_floating_point_v<A>), int> = 0>
inline double fmod(A a, B b) noexcept { return ::fmod(double(a), double(b)); }

/* C++20 lerp, exact at the ends and monotonic (the standard's contract). */
template <class T, enable_if_t<is_floating_point_v<T>, int> = 0>
constexpr T lerp(T a, T b, T t) noexcept {
  if ((a <= 0 && b >= 0) || (a >= 0 && b <= 0)) return t * b + (1 - t) * a;
  if (t == 1) return b;
  const T x = a + t * (b - a);
  return (t > 1) == (b > a) ? (b < x ? x : b) : (b > x ? x : b);
}
}  // namespace std
#endif
