/* system_error ... LithoRoot std L7 (S4, 2026-11-16): error_category,
 * error_code, error_condition, generic/system categories, system_error.
 * std::errc comes from lithoroot_errc.h (shared with <charconv>). The two
 * categories are constant-initialised globals, not function-local statics,
 * so no __cxa_guard (whose LithoAbi implementation still takes a lock until
 * the S5 rewrite) is ever reached. system_category == generic_category on
 * web: LithoLibC errno values are the only system errors there. */
#ifndef LITHOROOT_SYSTEM_ERROR
#define LITHOROOT_SYSTEM_ERROR
#if !defined(__wasm__)
#error "LithoRoot std headers are wasm32-only; native builds use their own C++ library"
#endif
#include <compare>
#include <cstring>
#include <functional>
#include <lithoroot_errc.h>
#include <stdexcept>
#include <string>
#include <type_traits>

namespace std {

class error_condition;
class error_code;
template <class T> struct is_error_code_enum : false_type {};
template <class T> struct is_error_condition_enum : false_type {};
template <> struct is_error_condition_enum<errc> : true_type {};
template <class T> inline constexpr bool is_error_code_enum_v = is_error_code_enum<T>::value;
template <class T> inline constexpr bool is_error_condition_enum_v = is_error_condition_enum<T>::value;

class error_category {
 public:
  constexpr error_category() noexcept = default;
  error_category(const error_category&) = delete;
  error_category& operator=(const error_category&) = delete;
  constexpr virtual ~error_category() = default;
  virtual const char* name() const noexcept = 0;
  virtual error_condition default_error_condition(int ev) const noexcept;
  virtual bool equivalent(int code, const error_condition& cond) const noexcept;
  virtual bool equivalent(const error_code& code, int cond) const noexcept;
  virtual string message(int ev) const = 0;
  bool operator==(const error_category& o) const noexcept { return this == &o; }
  strong_ordering operator<=>(const error_category& o) const noexcept { return compare_three_way()(this, &o); }
};

namespace __lk {
class generic_cat final : public error_category {
 public:
  constexpr generic_cat() noexcept = default;
  const char* name() const noexcept override { return "generic"; }
  string message(int ev) const override { return string(std::strerror(ev)); }
};
class system_cat final : public error_category {
 public:
  constexpr system_cat() noexcept = default;
  const char* name() const noexcept override { return "system"; }
  string message(int ev) const override { return string(std::strerror(ev)); }
  error_condition default_error_condition(int ev) const noexcept override;
};
constinit inline generic_cat g_generic_cat;
constinit inline system_cat g_system_cat;
}  // namespace __lk
inline const error_category& generic_category() noexcept { return __lk::g_generic_cat; }
inline const error_category& system_category() noexcept { return __lk::g_system_cat; }

class error_condition {
 public:
  error_condition() noexcept : v_(0), c_(&generic_category()) {}
  error_condition(int v, const error_category& c) noexcept : v_(v), c_(&c) {}
  template <class E, class = enable_if_t<is_error_condition_enum_v<E>>> error_condition(E e) noexcept { *this = make_error_condition(e); }
  void assign(int v, const error_category& c) noexcept { v_ = v; c_ = &c; }
  void clear() noexcept { v_ = 0; c_ = &generic_category(); }
  int value() const noexcept { return v_; }
  const error_category& category() const noexcept { return *c_; }
  string message() const { return c_->message(v_); }
  explicit operator bool() const noexcept { return v_ != 0; }
 private:
  int v_;
  const error_category* c_;
};
inline error_condition make_error_condition(errc e) noexcept { return error_condition(int(e), generic_category()); }

class error_code {
 public:
  error_code() noexcept : v_(0), c_(&system_category()) {}
  error_code(int v, const error_category& c) noexcept : v_(v), c_(&c) {}
  template <class E, class = enable_if_t<is_error_code_enum_v<E>>> error_code(E e) noexcept { *this = make_error_code(e); }
  void assign(int v, const error_category& c) noexcept { v_ = v; c_ = &c; }
  void clear() noexcept { v_ = 0; c_ = &system_category(); }
  int value() const noexcept { return v_; }
  const error_category& category() const noexcept { return *c_; }
  error_condition default_error_condition() const noexcept { return c_->default_error_condition(v_); }
  string message() const { return c_->message(v_); }
  explicit operator bool() const noexcept { return v_ != 0; }
 private:
  int v_;
  const error_category* c_;
};
inline error_code make_error_code(errc e) noexcept { return error_code(int(e), generic_category()); }

inline error_condition error_category::default_error_condition(int ev) const noexcept { return error_condition(ev, *this); }
inline bool error_category::equivalent(int code, const error_condition& cond) const noexcept {
  const error_condition d = default_error_condition(code);
  return d.category() == cond.category() && d.value() == cond.value();
}
inline bool error_category::equivalent(const error_code& code, int cond) const noexcept { return *this == code.category() && code.value() == cond; }
inline error_condition __lk::system_cat::default_error_condition(int ev) const noexcept { return error_condition(ev, generic_category()); }

inline bool operator==(const error_code& a, const error_code& b) noexcept { return a.category() == b.category() && a.value() == b.value(); }
inline bool operator==(const error_code& a, const error_condition& b) noexcept {
  return a.category().equivalent(a.value(), b) || b.category().equivalent(a, b.value());
}
inline bool operator==(const error_condition& a, const error_condition& b) noexcept { return a.category() == b.category() && a.value() == b.value(); }
inline strong_ordering operator<=>(const error_code& a, const error_code& b) noexcept {
  if (auto c = a.category() <=> b.category(); c != 0) return c;
  return a.value() <=> b.value();
}
inline bool operator==(const error_code& a, errc b) noexcept { return a == make_error_condition(b); }

class system_error : public runtime_error {
 public:
  system_error(error_code ec, const string& w) : runtime_error(w + ": " + ec.message()), ec_(ec) {}
  system_error(error_code ec, const char* w) : runtime_error(string(w) + ": " + ec.message()), ec_(ec) {}
  explicit system_error(error_code ec) : runtime_error(ec.message()), ec_(ec) {}
  system_error(int ev, const error_category& c, const string& w) : system_error(error_code(ev, c), w) {}
  system_error(int ev, const error_category& c) : system_error(error_code(ev, c)) {}
  const error_code& code() const noexcept { return ec_; }
 private:
  error_code ec_;
};

template <> struct hash<error_code> {
  size_t operator()(const error_code& e) const noexcept { return size_t(e.value()) ^ reinterpret_cast<size_t>(&e.category()); }
};

}  // namespace std
#endif
