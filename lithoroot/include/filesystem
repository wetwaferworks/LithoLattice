/* filesystem ... LithoRoot std L10 (S4 tail, 2026-11-16): the std::filesystem
 * subset from plan §1.3/§3.8, sized to the census (81 files: path 473 refs,
 * remove_all, create_directories, exists, temp_directory_path, ...).
 *
 * path (header-only, complete for the census): POSIX generic format, char
 * only, '/' separator; decomposition (root_name is always empty), has_*, /,
 * /=, +=, replace_extension/filename, remove_filename, lexically_normal /
 * relative / proximate, iteration over elements, comparison, hash.
 *
 * Operations are declared here in their error_code form and defined by
 * LithoVFS (plan S7: the writable RAM tree over the read-only volume,
 * persisted through lk_store_*). The throwing forms are inline wrappers that
 * throw filesystem_error, so S7 has one function per operation to supply.
 * Until S7 links, a TU that calls an operation compiles but does not link.
 *
 * Not provided: wide/u8 path encodings (wstring, u16/u32), locale, space(),
 * hard links, equivalent(), operator<< (no iostreams on web). */
#ifndef LITHOROOT_FILESYSTEM
#define LITHOROOT_FILESYSTEM
#if !defined(__wasm__)
#error "LithoRoot std headers are wasm32-only; native builds use their own C++ library"
#endif
