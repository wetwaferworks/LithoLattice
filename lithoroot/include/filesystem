#define LR_FS_THROW1(expr, name, p) error_code ec; auto r = expr; if (ec) __lk_fs::raise(name, p, ec); return r
#define LR_FS_THROWV(expr, name, ...) error_code ec; expr; if (ec) __lk_fs::raise(name, __VA_ARGS__, ec)

inline file_status status(const path& p) { error_code ec; file_status s = status(p, ec); if (ec && s.type() != file_type::not_found) __lk_fs::raise("status", p, ec); return s; }
inline file_status symlink_status(const path& p) { error_code ec; file_status s = symlink_status(p, ec); if (ec && s.type() != file_type::not_found) __lk_fs::raise("symlink_status", p, ec); return s; }
inline bool status_known(file_status s) noexcept { return s.type() != file_type::none; }
inline bool exists(file_status s) noexcept { return status_known(s) && s.type() != file_type::not_found; }
inline bool is_directory(file_status s) noexcept { return s.type() == file_type::directory; }
inline bool is_regular_file(file_status s) noexcept { return s.type() == file_type::regular; }
inline bool is_symlink(file_status s) noexcept { return s.type() == file_type::symlink; }
inline bool is_other(file_status s) noexcept { return exists(s) && !is_regular_file(s) && !is_directory(s) && !is_symlink(s); }
inline bool exists(const path& p) { return exists(status(p)); }
inline bool exists(const path& p, error_code& ec) noexcept { file_status s = status(p, ec); if (s.type() == file_type::not_found) ec.clear(); return exists(s); }
inline bool is_directory(const path& p) { return is_directory(status(p)); }
inline bool is_directory(const path& p, error_code& ec) noexcept { return is_directory(status(p, ec)); }
inline bool is_regular_file(const path& p) { return is_regular_file(status(p)); }
inline bool is_regular_file(const path& p, error_code& ec) noexcept { return is_regular_file(status(p, ec)); }
inline bool is_symlink(const path& p) { return is_symlink(symlink_status(p)); }
inline bool is_symlink(const path& p, error_code& ec) noexcept { return is_symlink(symlink_status(p, ec)); }
inline bool create_directory(const path& p) { LR_FS_THROW1(create_directory(p, ec), "create_directory", p); }
inline bool create_directories(const path& p) { LR_FS_THROW1(create_directories(p, ec), "create_directories", p); }
inline void create_symlink(const path& t, const path& l) { LR_FS_THROWV(create_symlink(t, l, ec), "create_symlink", t, l); }
inline void create_directory_symlink(const path& t, const path& l) { LR_FS_THROWV(create_directory_symlink(t, l, ec), "create_directory_symlink", t, l); }
inline bool remove(const path& p) { LR_FS_THROW1(remove(p, ec), "remove", p); }
inline uintmax_t remove_all(const path& p) { LR_FS_THROW1(remove_all(p, ec), "remove_all", p); }
inline void rename(const path& a, const path& b) { LR_FS_THROWV(rename(a, b, ec), "rename", a, b); }
inline uintmax_t file_size(const path& p) { LR_FS_THROW1(file_size(p, ec), "file_size", p); }
inline void resize_file(const path& p, uintmax_t n) { LR_FS_THROWV(resize_file(p, n, ec), "resize_file", p); }
inline bool copy_file(const path& a, const path& b, copy_options o) { error_code ec; bool r = copy_file(a, b, o, ec); if (ec) __lk_fs::raise("copy_file", a, b, ec); return r; }
inline bool copy_file(const path& a, const path& b) { return copy_file(a, b, copy_options::none); }
inline bool copy_file(const path& a, const path& b, error_code& ec) { return copy_file(a, b, copy_options::none, ec); }
inline file_time_type last_write_time(const path& p) { LR_FS_THROW1(last_write_time(p, ec), "last_write_time", p); }
inline void last_write_time(const path& p, file_time_type t) { LR_FS_THROWV(last_write_time(p, t, ec), "last_write_time", p); }
inline void permissions(const path& p, perms pr, perm_options o = perm_options::replace) { LR_FS_THROWV(permissions(p, pr, o, ec), "permissions", p); }
inline void permissions(const path& p, perms pr, error_code& ec) { permissions(p, pr, perm_options::replace, ec); }
inline path current_path() { error_code ec; path r = current_path(ec); if (ec) __lk_fs::raise("current_path", path(), ec); return r; }
inline void current_path(const path& p) { LR_FS_THROWV(current_path(p, ec), "current_path", p); }
inline path temp_directory_path() { error_code ec; path r = temp_directory_path(ec); if (ec) __lk_fs::raise("temp_directory_path", path(), ec); return r; }
inline path canonical(const path& p) { LR_FS_THROW1(canonical(p, ec), "canonical", p); }
inline path weakly_canonical(const path& p) { LR_FS_THROW1(weakly_canonical(p, ec), "weakly_canonical", p); }
inline path read_symlink(const path& p) { LR_FS_THROW1(read_symlink(p, ec), "read_symlink", p); }
/* absolute/relative/proximate are lexical over current_path() (no VFS call besides it). */
inline path absolute(const path& p, error_code& ec) { ec.clear(); if (p.is_absolute()) return p; path c = current_path(ec); return ec ? path() : c / p; }
inline path absolute(const path& p) { LR_FS_THROW1(absolute(p, ec), "absolute", p); }
inline path relative(const path& p, const path& base, error_code& ec) {
  path a = weakly_canonical(p, ec); if (ec) return path();
  path b = weakly_canonical(base, ec); if (ec) return path();
  return a.lexically_relative(b);
}
inline path relative(const path& p, const path& base = current_path()) { error_code ec; path r = relative(p, base, ec); if (ec) __lk_fs::raise("relative", p, base, ec); return r; }
inline path relative(const path& p, error_code& ec) { path c = current_path(ec); return ec ? path() : relative(p, c, ec); }
inline path proximate(const path& p, const path& base, error_code& ec) {
  path a = weakly_canonical(p, ec); if (ec) return path();
  path b = weakly_canonical(base, ec); if (ec) return path();
  return a.lexically_proximate(b);
}
inline path proximate(const path& p, const path& base = current_path()) { error_code ec; path r = proximate(p, base, ec); if (ec) __lk_fs::raise("proximate", p, base, ec); return r; }
inline bool is_empty(const path& p, error_code& ec);
inline bool is_empty(const path& p) { LR_FS_THROW1(is_empty(p, ec), "is_empty", p); }
#undef LR_FS_THROW1
#undef LR_FS_THROWV

class directory_entry {
 public:
  directory_entry() noexcept = default;
  explicit directory_entry(const filesystem::path& p) : p_(p) {}
  directory_entry(const filesystem::path& p, error_code& ec) : p_(p) { ec.clear(); }
  const filesystem::path& path() const noexcept { return p_; }
  operator const filesystem::path&() const noexcept { return p_; }
  void assign(const filesystem::path& p) { p_ = p; }
  void refresh() {}
  void refresh(error_code& ec) noexcept { ec.clear(); }
  file_status status() const { return filesystem::status(p_); }
  file_status status(error_code& ec) const noexcept { return filesystem::status(p_, ec); }
  file_status symlink_status() const { return filesystem::symlink_status(p_); }
  file_status symlink_status(error_code& ec) const noexcept { return filesystem::symlink_status(p_, ec); }
  bool exists() const { return filesystem::exists(p_); }
  bool exists(error_code& ec) const noexcept { return filesystem::exists(p_, ec); }
  bool is_directory() const { return filesystem::is_directory(p_); }
  bool is_directory(error_code& ec) const noexcept { return filesystem::is_directory(p_, ec); }
  bool is_regular_file() const { return filesystem::is_regular_file(p_); }
  bool is_regular_file(error_code& ec) const noexcept { return filesystem::is_regular_file(p_, ec); }
  bool is_symlink() const { return filesystem::is_symlink(p_); }
  bool is_symlink(error_code& ec) const noexcept { return filesystem::is_symlink(p_, ec); }
  uintmax_t file_size() const { return filesystem::file_size(p_); }
  uintmax_t file_size(error_code& ec) const noexcept { return filesystem::file_size(p_, ec); }
  file_time_type last_write_time() const { return filesystem::last_write_time(p_); }
  file_time_type last_write_time(error_code& ec) const noexcept { return filesystem::last_write_time(p_, ec); }
  friend bool operator==(const directory_entry& a, const directory_entry& b) noexcept { return a.p_ == b.p_; }
  friend strong_ordering operator<=>(const directory_entry& a, const directory_entry& b) noexcept { return a.p_ <=> b.p_; }
 private:
  filesystem::path p_;
};

/* Listing order is sorted by name (LithoVFS), so iteration is deterministic. */
class directory_iterator {
 public:
  using iterator_category = input_iterator_tag;
  using value_type = directory_entry;
  using difference_type = ptrdiff_t;
  using pointer = const directory_entry*;
  using reference = const directory_entry&;
  directory_iterator() noexcept = default;
  explicit directory_iterator(const path& p) : directory_iterator(p, directory_options::none) {}
  directory_iterator(const path& p, directory_options o) {
    error_code ec; open(p, o, ec);
    if (ec) __lk_fs::raise("directory_iterator", p, ec);
  }
  directory_iterator(const path& p, error_code& ec) { open(p, directory_options::none, ec); }
  directory_iterator(const path& p, directory_options o, error_code& ec) { open(p, o, ec); }
  reference operator*() const { return s_->cur; }
  pointer operator->() const { return &s_->cur; }
  directory_iterator& operator++() { advance(); return *this; }
  directory_iterator& increment(error_code& ec) { ec.clear(); advance(); return *this; }
  friend bool operator==(const directory_iterator& a, const directory_iterator& b) noexcept { return a.s_ == b.s_; }
  friend directory_iterator begin(directory_iterator it) noexcept { return it; }
  friend directory_iterator end(const directory_iterator&) noexcept { return directory_iterator(); }
 private:
  struct state { path dir; vector<string> names; size_t i = 0; directory_entry cur; };
  void open(const path& p, directory_options o, error_code& ec) {
    auto st = make_shared<state>();
    st->dir = p;
    if (!__lk_list_dir(p, st->names, ec)) {
      if (ec == errc::permission_denied && (o & directory_options::skip_permission_denied) != directory_options::none) ec.clear();
      return;
    }
    ec.clear();
    if (st->names.empty()) return;
    st->cur.assign(p / st->names[0]);
    s_ = std::move(st);
  }
  void advance() {
    if (!s_) return;
    if (++s_->i >= s_->names.size()) { s_.reset(); return; }
    s_->cur.assign(s_->dir / s_->names[s_->i]);
  }
  shared_ptr<state> s_;
};

class recursive_directory_iterator {
 public:
  using iterator_category = input_iterator_tag;
  using value_type = directory_entry;
  using difference_type = ptrdiff_t;
  using pointer = const directory_entry*;
  using reference = const directory_entry&;
  recursive_directory_iterator() noexcept = default;
  explicit recursive_directory_iterator(const path& p, directory_options o = directory_options::none) : o_(o) {
    error_code ec; init(p, ec); if (ec) __lk_fs::raise("recursive_directory_iterator", p, ec);
  }
  recursive_directory_iterator(const path& p, error_code& ec) { init(p, ec); }
  recursive_directory_iterator(const path& p, directory_options o, error_code& ec) : o_(o) { init(p, ec); }
  reference operator*() const { return *s_->stack.back(); }
  pointer operator->() const { return &*s_->stack.back(); }
  directory_options options() const { return o_; }
  int depth() const { return int(s_->stack.size()) - 1; }
  bool recursion_pending() const { return s_->pending; }
  void disable_recursion_pending() { s_->pending = false; }
  void pop() { s_->stack.pop_back(); s_->pending = false; if (s_->stack.empty()) { s_.reset(); return; } step(); }
  recursive_directory_iterator& operator++() { error_code ec; increment(ec); if (ec) __lk_fs::raise("recursive_directory_iterator", path(), ec); return *this; }
  recursive_directory_iterator& increment(error_code& ec) {
    ec.clear();
    if (!s_) return *this;
    const directory_entry& e = *s_->stack.back();
    if (s_->pending && e.is_directory(ec) && !e.is_symlink(ec)) {
      directory_iterator child(e.path(), o_, ec);
      if (ec) return *this;
      if (child != directory_iterator()) { s_->stack.push_back(child); s_->pending = true; return *this; }
    }
    ec.clear();
    s_->pending = true;
    step();
    return *this;
  }
  friend bool operator==(const recursive_directory_iterator& a, const recursive_directory_iterator& b) noexcept { return a.s_ == b.s_; }
  friend recursive_directory_iterator begin(recursive_directory_iterator it) noexcept { return it; }
  friend recursive_directory_iterator end(const recursive_directory_iterator&) noexcept { return recursive_directory_iterator(); }
 private:
  struct state { vector<directory_iterator> stack; bool pending = true; };
  void init(const path& p, error_code& ec) {
    directory_iterator it(p, o_, ec);
    if (ec || it == directory_iterator()) return;
    s_ = make_shared<state>();
    s_->stack.push_back(it);
  }
  void step() {  // advance the top; unwind finished levels
    while (s_) {
      ++s_->stack.back();
      if (s_->stack.back() != directory_iterator()) return;
      s_->stack.pop_back();
      if (s_->stack.empty()) { s_.reset(); return; }
    }
  }
  directory_options o_ = directory_options::none;
  shared_ptr<state> s_;
};

inline bool is_empty(const path& p, error_code& ec) {
  file_status s = status(p, ec);
  if (ec) return false;
  if (is_directory(s)) { directory_iterator it(p, ec); return !ec && it == directory_iterator(); }
  uintmax_t n = file_size(p, ec);
  return !ec && n == 0;
}

