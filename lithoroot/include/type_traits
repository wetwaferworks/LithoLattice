template <class T, class U> struct is_same : bool_constant<__is_same(T, U)> {};
template <class T, class U> inline constexpr bool is_same_v = __is_same(T, U);
template <class B, class D> struct is_base_of : bool_constant<__is_base_of(B, D)> {};
template <class B, class D> inline constexpr bool is_base_of_v = __is_base_of(B, D);
template <class F, class T> struct is_convertible : bool_constant<__is_convertible(F, T)> {};
template <class F, class T> inline constexpr bool is_convertible_v = __is_convertible(F, T);
template <class F, class T> struct is_nothrow_convertible : bool_constant<__is_nothrow_convertible(F, T)> {};
template <class F, class T> inline constexpr bool is_nothrow_convertible_v = __is_nothrow_convertible(F, T);
template <class T, class... A> struct is_constructible : bool_constant<__is_constructible(T, A...)> {};
template <class T, class... A> inline constexpr bool is_constructible_v = __is_constructible(T, A...);
template <class T, class... A> struct is_trivially_constructible : bool_constant<__is_trivially_constructible(T, A...)> {};
template <class T, class... A> inline constexpr bool is_trivially_constructible_v = __is_trivially_constructible(T, A...);
template <class T, class... A> struct is_nothrow_constructible : bool_constant<__is_nothrow_constructible(T, A...)> {};
template <class T, class... A> inline constexpr bool is_nothrow_constructible_v = __is_nothrow_constructible(T, A...);
template <class T, class U> struct is_assignable : bool_constant<__is_assignable(T, U)> {};
template <class T, class U> inline constexpr bool is_assignable_v = __is_assignable(T, U);
template <class T, class U> struct is_trivially_assignable : bool_constant<__is_trivially_assignable(T, U)> {};
template <class T, class U> inline constexpr bool is_trivially_assignable_v = __is_trivially_assignable(T, U);
template <class T, class U> struct is_nothrow_assignable : bool_constant<__is_nothrow_assignable(T, U)> {};
template <class T, class U> inline constexpr bool is_nothrow_assignable_v = __is_nothrow_assignable(T, U);
template <class T> struct is_scoped_enum : bool_constant<__is_scoped_enum(T)> {};
template <class T> inline constexpr bool is_scoped_enum_v = __is_scoped_enum(T);

template <class T> struct alignment_of : integral_constant<size_t, alignof(T)> {};
template <class T> inline constexpr size_t alignment_of_v = alignof(T);
template <class T> struct rank : integral_constant<size_t, __array_rank(T)> {};
template <class T> inline constexpr size_t rank_v = __array_rank(T);
template <class T, unsigned I = 0> struct extent : integral_constant<size_t, __array_extent(T, I)> {};
template <class T, unsigned I = 0> inline constexpr size_t extent_v = __array_extent(T, I);

/* ---- logic ---- */
template <class... B> struct conjunction : true_type {};
template <class B> struct conjunction<B> : B {};
template <class B, class... R> struct conjunction<B, R...> : conditional_t<bool(B::value), conjunction<R...>, B> {};
template <class... B> struct disjunction : false_type {};
template <class B> struct disjunction<B> : B {};
template <class B, class... R> struct disjunction<B, R...> : conditional_t<bool(B::value), B, disjunction<R...>> {};
template <class B> struct negation : bool_constant<!bool(B::value)> {};
template <class... B> inline constexpr bool conjunction_v = conjunction<B...>::value;
template <class... B> inline constexpr bool disjunction_v = disjunction<B...>::value;
template <class B> inline constexpr bool negation_v = !bool(B::value);

/* ---- common_type / common_reference (the forms the tree needs) ---- */
template <class... T> struct common_type {};
template <class... T> using common_type_t = typename common_type<T...>::type;
template <class T> struct common_type<T> : common_type<T, T> {};
namespace __lk {
template <class T, class U> using cond_t = decltype(false ? declval<T>() : declval<U>());
template <class T, class U, class = void> struct common2 {};
template <class T, class U> struct common2<T, U, void_t<cond_t<T, U>>> { using type = __decay(cond_t<T, U>); };
}  // namespace __lk
template <class T, class U> struct common_type<T, U> : __lk::common2<__decay(T), __decay(U)> {};
template <class T, class U, class V, class... R>
struct common_type<T, U, V, R...> : common_type<common_type_t<T, U>, V, R...> {};

/* ---- invoke_result (callables and member pointers) ---- */
template <class T> class reference_wrapper;  // <functional>; named here for the INVOKE ref-wrapper rule
namespace __lk {
template <class T> struct mp_class {};
template <class M, class C> struct mp_class<M C::*> { using type = C; };
template <class F, class... A, class = enable_if_t<!__is_member_pointer(__decay(F))>>
auto inv(F&& f, A&&... a) -> decltype(static_cast<F&&>(f)(static_cast<A&&>(a)...));
template <class F, class O, class... A, class = enable_if_t<__is_member_function_pointer(__decay(F))>>
auto inv(F&& f, O&& o, A&&... a) -> decltype((static_cast<O&&>(o).*f)(static_cast<A&&>(a)...));
template <class F, class O, class... A, class = enable_if_t<__is_member_function_pointer(__decay(F))>, class = void>
auto inv(F&& f, O&& o, A&&... a) -> decltype(((*static_cast<O&&>(o)).*f)(static_cast<A&&>(a)...));
template <class F, class O, class = enable_if_t<__is_member_object_pointer(__decay(F))>>
auto inv(F&& f, O&& o) -> decltype(static_cast<O&&>(o).*f);
/* INVOKE on a reference_wrapper object: call through .get() ([func.require] 1.2/1.5). */
template <class F, class O, class... A, class = enable_if_t<__is_member_function_pointer(__decay(F))>>
auto inv(F&& f, reference_wrapper<O> o, A&&... a) -> decltype((o.get().*f)(static_cast<A&&>(a)...));
template <class F, class O, class = enable_if_t<__is_member_object_pointer(__decay(F))>>
auto inv(F&& f, reference_wrapper<O> o) -> decltype(o.get().*f);
template <class F, class O, class = enable_if_t<__is_member_object_pointer(__decay(F))>, class = void>
auto inv(F&& f, O&& o) -> decltype((*static_cast<O&&>(o)).*f);
template <class V, class F, class... A> struct invres {};
template <class F, class... A> struct invres<void_t<decltype(inv(declval<F>(), declval<A>()...))>, F, A...> {
  using type = decltype(inv(declval<F>(), declval<A>()...));
};
}  // namespace __lk
template <class F, class... A> struct invoke_result : __lk::invres<void, F, A...> {};
template <class F, class... A> using invoke_result_t = typename invoke_result<F, A...>::type;
namespace __lk {
template <class V, class F, class... A> struct isinv : false_type {};
template <class F, class... A> struct isinv<void_t<invoke_result_t<F, A...>>, F, A...> : true_type {};
template <class V, class R, class F, class... A> struct isinvr : false_type {};
template <class R, class F, class... A>
struct isinvr<void_t<invoke_result_t<F, A...>>, R, F, A...>
    : bool_constant<__is_same(R, void) || __is_convertible(invoke_result_t<F, A...>, R)> {};
}  // namespace __lk
template <class F, class... A> struct is_invocable : __lk::isinv<void, F, A...> {};
template <class F, class... A> inline constexpr bool is_invocable_v = is_invocable<F, A...>::value;
template <class R, class F, class... A> struct is_invocable_r : __lk::isinvr<void, R, F, A...> {};
template <class R, class F, class... A> inline constexpr bool is_invocable_r_v = is_invocable_r<R, F, A...>::value;
namespace __lk {
template <bool, class F, class... A> struct isninv : false_type {};
template <class F, class... A>
struct isninv<true, F, A...> : bool_constant<noexcept(inv(declval<F>(), declval<A>()...))> {};
}  // namespace __lk
template <class F, class... A> struct is_nothrow_invocable : __lk::isninv<is_invocable_v<F, A...>, F, A...> {};
template <class F, class... A> inline constexpr bool is_nothrow_invocable_v = is_nothrow_invocable<F, A...>::value;

template <size_t Len, size_t Align = alignof(max_align_t)>
struct aligned_storage { struct type { alignas(Align) unsigned char data[Len]; }; };

constexpr bool is_constant_evaluated() noexcept { return __builtin_is_constant_evaluated(); }

}  // namespace std
#endif
