/* type_traits ... LithoRoot std, layer L0 (S2, 2026-11-16).
 * Built almost entirely on clang 20's type-trait builtins, so each
 * answer is the compiler's own. Only what the tree uses, plus the
 * neighbours that make the set coherent. */
#ifndef LITHOROOT_TYPE_TRAITS
#define LITHOROOT_TYPE_TRAITS
#if !defined(__wasm__)
#error "LithoRoot std headers are wasm32-only; native builds use their own C++ library"
#endif
#include <cstddef>

namespace std {

template <class T, T v>
struct integral_constant {
  static constexpr T value = v;
  using value_type = T;
  using type = integral_constant;
  constexpr operator value_type() const noexcept { return value; }
  constexpr value_type operator()() const noexcept { return value; }
};
template <bool B> using bool_constant = integral_constant<bool, B>;
using true_type = bool_constant<true>;
using false_type = bool_constant<false>;

template <class T> struct type_identity { using type = T; };
template <class T> using type_identity_t = typename type_identity<T>::type;

template <bool B, class T = void> struct enable_if {};
template <class T> struct enable_if<true, T> { using type = T; };
template <bool B, class T = void> using enable_if_t = typename enable_if<B, T>::type;

template <bool B, class T, class F> struct conditional { using type = T; };
template <class T, class F> struct conditional<false, T, F> { using type = F; };
template <bool B, class T, class F> using conditional_t = typename conditional<B, T, F>::type;

template <class...> using void_t = void;

/* ---- cv / ref / pointer transforms (builtins) ---- */
template <class T> struct remove_const { using type = __remove_const(T); };
template <class T> struct remove_volatile { using type = __remove_volatile(T); };
template <class T> struct remove_cv { using type = __remove_cv(T); };
template <class T> struct remove_reference { using type = __remove_reference_t(T); };
template <class T> struct remove_cvref { using type = __remove_cvref(T); };
template <class T> struct remove_pointer { using type = __remove_pointer(T); };
template <class T> struct remove_extent { using type = __remove_extent(T); };
template <class T> struct remove_all_extents { using type = __remove_all_extents(T); };
template <class T> struct add_const { using type = const T; };
template <class T> struct add_volatile { using type = volatile T; };
template <class T> struct add_cv { using type = const volatile T; };
template <class T> struct add_pointer { using type = __add_pointer(T); };
template <class T> struct add_lvalue_reference { using type = __add_lvalue_reference(T); };
template <class T> struct add_rvalue_reference { using type = __add_rvalue_reference(T); };
template <class T> struct decay { using type = __decay(T); };
template <class T> struct make_signed { using type = __make_signed(T); };
template <class T> struct make_unsigned { using type = __make_unsigned(T); };
template <class T> struct underlying_type { using type = __underlying_type(T); };

template <class T> using remove_const_t = typename remove_const<T>::type;
template <class T> using remove_volatile_t = typename remove_volatile<T>::type;
template <class T> using remove_cv_t = typename remove_cv<T>::type;
template <class T> using remove_reference_t = typename remove_reference<T>::type;
template <class T> using remove_cvref_t = typename remove_cvref<T>::type;
template <class T> using remove_pointer_t = typename remove_pointer<T>::type;
template <class T> using remove_extent_t = typename remove_extent<T>::type;
template <class T> using remove_all_extents_t = typename remove_all_extents<T>::type;
template <class T> using add_const_t = const T;
template <class T> using add_volatile_t = volatile T;
template <class T> using add_cv_t = const volatile T;
template <class T> using add_pointer_t = typename add_pointer<T>::type;
template <class T> using add_lvalue_reference_t = typename add_lvalue_reference<T>::type;
template <class T> using add_rvalue_reference_t = typename add_rvalue_reference<T>::type;
template <class T> using decay_t = typename decay<T>::type;
template <class T> using make_signed_t = typename make_signed<T>::type;
template <class T> using make_unsigned_t = typename make_unsigned<T>::type;
template <class T> using underlying_type_t = typename underlying_type<T>::type;

template <class T> add_rvalue_reference_t<T> declval() noexcept;  // unevaluated contexts only

/* ---- primary / composite categories ---- */
#define LR_TRAIT(name, expr) \
  template <class T> struct name : bool_constant<expr> {}; \
  template <class T> inline constexpr bool name##_v = expr;
LR_TRAIT(is_void, __is_same(__remove_cv(T), void))
LR_TRAIT(is_null_pointer, __is_same(__remove_cv(T), decltype(nullptr)))
LR_TRAIT(is_integral, __is_integral(T))
LR_TRAIT(is_floating_point, __is_floating_point(T))
LR_TRAIT(is_array, __is_array(T))
LR_TRAIT(is_enum, __is_enum(T))
LR_TRAIT(is_union, __is_union(T))
LR_TRAIT(is_class, __is_class(T))
LR_TRAIT(is_function, __is_function(T))
LR_TRAIT(is_pointer, __is_pointer(T))
LR_TRAIT(is_lvalue_reference, __is_lvalue_reference(T))
LR_TRAIT(is_rvalue_reference, __is_rvalue_reference(T))
LR_TRAIT(is_reference, __is_reference(T))
LR_TRAIT(is_member_pointer, __is_member_pointer(T))
LR_TRAIT(is_member_object_pointer, __is_member_object_pointer(T))
LR_TRAIT(is_member_function_pointer, __is_member_function_pointer(T))
LR_TRAIT(is_arithmetic, __is_arithmetic(T))
LR_TRAIT(is_fundamental, __is_fundamental(T))
LR_TRAIT(is_scalar, __is_scalar(T))
LR_TRAIT(is_object, __is_object(T))
LR_TRAIT(is_compound, __is_compound(T))
LR_TRAIT(is_const, __is_const(T))
LR_TRAIT(is_volatile, __is_volatile(T))
LR_TRAIT(is_trivial, __is_trivial(T))
LR_TRAIT(is_trivially_copyable, __is_trivially_copyable(T))
LR_TRAIT(is_standard_layout, __is_standard_layout(T))
LR_TRAIT(is_empty, __is_empty(T))
LR_TRAIT(is_polymorphic, __is_polymorphic(T))
LR_TRAIT(is_abstract, __is_abstract(T))
LR_TRAIT(is_final, __is_final(T))
LR_TRAIT(is_aggregate, __is_aggregate(T))
LR_TRAIT(is_signed, __is_signed(T))
LR_TRAIT(is_unsigned, __is_unsigned(T))
LR_TRAIT(is_bounded_array, __is_bounded_array(T))
LR_TRAIT(is_unbounded_array, __is_unbounded_array(T))
LR_TRAIT(is_default_constructible, __is_constructible(T))
LR_TRAIT(is_trivially_default_constructible, __is_trivially_constructible(T))
LR_TRAIT(is_nothrow_default_constructible, __is_nothrow_constructible(T))
LR_TRAIT(is_copy_constructible, __is_constructible(T, __add_lvalue_reference(const T)))
LR_TRAIT(is_trivially_copy_constructible, __is_trivially_constructible(T, __add_lvalue_reference(const T)))
LR_TRAIT(is_nothrow_copy_constructible, __is_nothrow_constructible(T, __add_lvalue_reference(const T)))
