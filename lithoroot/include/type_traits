LR_TRAIT(is_trivially_move_constructible, __is_trivially_constructible(T, __add_rvalue_reference(T)))
LR_TRAIT(is_nothrow_move_constructible, __is_nothrow_constructible(T, __add_rvalue_reference(T)))
