/* set ... LithoRoot std L6 (S4, 2026-11-16): set<K, Cmp> over the shared
 * red-black tree. Ordered iteration; no multiset (census: unused). */
#ifndef LITHOROOT_SET
#define LITHOROOT_SET
#if !defined(__wasm__)
#error "LithoRoot std headers are wasm32-only; native builds use their own C++ library"
#endif
#include <algorithm>
#include <compare>
#include <functional>
#include <initializer_list>
#include <lithoroot_rbtree.h>
#include <utility>

namespace std {

template <class K, class Cmp = less<K>, class A = allocator<K>>
class set {
  struct key_of { const K& operator()(const K& v) const noexcept { return v; } };
  template <class Q> static constexpr bool transparent = requires { typename Cmp::is_transparent; };
  using tree = __lk::rb_tree<K, K, key_of, Cmp>;
  tree t_;
 public:
  using key_type = K;
  using value_type = K;
  using key_compare = Cmp;
  using value_compare = Cmp;
  using allocator_type = A;
  using size_type = size_t;
  using difference_type = ptrdiff_t;
  using reference = K&;
  using const_reference = const K&;
  using iterator = typename tree::const_iterator;  // set elements are immutable
  using const_iterator = typename tree::const_iterator;
  using reverse_iterator = std::reverse_iterator<iterator>;
  using const_reverse_iterator = std::reverse_iterator<const_iterator>;

  set() = default;
  explicit set(const Cmp& c) : t_(c) {}
  template <class It> set(It f, It l, const Cmp& c = Cmp()) : t_(c) { insert(f, l); }
  set(initializer_list<K> il, const Cmp& c = Cmp()) : t_(c) { insert(il.begin(), il.end()); }
  set& operator=(initializer_list<K> il) { clear(); insert(il.begin(), il.end()); return *this; }

  iterator begin() const noexcept { return t_.begin(); }
  iterator end() const noexcept { return t_.end(); }
  iterator cbegin() const noexcept { return t_.begin(); }
  iterator cend() const noexcept { return t_.end(); }
  reverse_iterator rbegin() const noexcept { return reverse_iterator(end()); }
  reverse_iterator rend() const noexcept { return reverse_iterator(begin()); }
  [[nodiscard]] bool empty() const noexcept { return t_.empty(); }
  size_type size() const noexcept { return t_.size(); }
  key_compare key_comp() const { return t_.cmp(); }
  value_compare value_comp() const { return t_.cmp(); }

  template <class... Args> pair<iterator, bool> emplace(Args&&... a) { auto r = t_.emplace_unique(std::forward<Args>(a)...); return {r.first, r.second}; }
  template <class... Args> iterator emplace_hint(const_iterator h, Args&&... a) { return t_.emplace_hint_unique(h, std::forward<Args>(a)...); }
  pair<iterator, bool> insert(const K& v) { auto r = t_.find_or_make(v, [&] { return new typename tree::node(v); }); return {r.first, r.second}; }
  pair<iterator, bool> insert(K&& v) { auto r = t_.find_or_make(v, [&] { return new typename tree::node(std::move(v)); }); return {r.first, r.second}; }
  iterator insert(const_iterator, const K& v) { return insert(v).first; }
  iterator insert(const_iterator, K&& v) { return insert(std::move(v)).first; }
  template <class It> void insert(It f, It l) { for (; f != l; ++f) emplace(*f); }
  void insert(initializer_list<K> il) { insert(il.begin(), il.end()); }
  iterator erase(const_iterator it) { return t_.erase(it); }
  iterator erase(const_iterator f, const_iterator l) { return t_.erase(f, l); }
  size_type erase(const K& k) { return t_.erase_key(k); }
  void clear() noexcept { t_.clear(); }
  void swap(set& o) noexcept { t_.swap(o.t_); }

  iterator find(const K& k) const { return t_.find(k); }
  template <class Q, class = enable_if_t<transparent<Q>>> iterator find(const Q& k) const { return t_.find(k); }
  size_type count(const K& k) const { return find(k) != end() ? 1 : 0; }
  bool contains(const K& k) const { return find(k) != end(); }
  template <class Q, class = enable_if_t<transparent<Q>>> bool contains(const Q& k) const { return find(k) != end(); }
  iterator lower_bound(const K& k) const { return t_.lower_bound(k); }
  iterator upper_bound(const K& k) const { return t_.upper_bound(k); }
  pair<iterator, iterator> equal_range(const K& k) const { return {lower_bound(k), upper_bound(k)}; }
  int __verify() const noexcept { return t_.verify(); }
};

template <class K, class C, class A> bool operator==(const set<K, C, A>& a, const set<K, C, A>& b) { return a.size() == b.size() && std::equal(a.begin(), a.end(), b.begin()); }
template <class K, class C, class A> auto operator<=>(const set<K, C, A>& a, const set<K, C, A>& b) { return __lk::lex3(a.begin(), a.end(), b.begin(), b.end()); }
template <class K, class C, class A> void swap(set<K, C, A>& a, set<K, C, A>& b) noexcept { a.swap(b); }
template <class K, class C, class A, class P> size_t erase_if(set<K, C, A>& s, P p) {
  size_t n = 0;
  for (auto it = s.begin(); it != s.end();) { if (p(*it)) { it = s.erase(it); ++n; } else ++it; }
  return n;
}

}  // namespace std
#endif
