/* initializer_list ... LithoRoot std, layer L0 (compiler-coupled).
 * Clang builds std::initializer_list itself and requires exactly this
 * shape: two members, a begin pointer and a length, plus a private
 * constructor it calls directly (S2, 2026-11-16). */
#ifndef LITHOROOT_INITIALIZER_LIST
#define LITHOROOT_INITIALIZER_LIST
#if !defined(__wasm__)
#error "LithoRoot std headers are wasm32-only; native builds use their own C++ library"
#endif
#include <cstddef>

namespace std {

template <class E>
class initializer_list {
  const E* __b;
  size_t __n;
  constexpr initializer_list(const E* b, size_t n) noexcept : __b(b), __n(n) {}

 public:
  using value_type = E;
  using reference = const E&;
  using const_reference = const E&;
  using size_type = size_t;
  using iterator = const E*;
  using const_iterator = const E*;
  constexpr initializer_list() noexcept : __b(nullptr), __n(0) {}
  constexpr size_t size() const noexcept { return __n; }
  constexpr const E* begin() const noexcept { return __b; }
  constexpr const E* end() const noexcept { return __b + __n; }
};

template <class E> constexpr const E* begin(initializer_list<E> il) noexcept { return il.begin(); }
template <class E> constexpr const E* end(initializer_list<E> il) noexcept { return il.end(); }

}  // namespace std
#endif
