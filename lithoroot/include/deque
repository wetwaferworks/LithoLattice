/* deque ... LithoRoot std L6 (S4, 2026-11-16): deque<T> as a block map. Fixed
 * blocks (at least 16 elements or 512 bytes) hang off a growable map of block
 * pointers, so push/pop at either end never moves an element: references stay
 * valid, as the standard requires. Random access is two index steps. */
#ifndef LITHOROOT_DEQUE
#define LITHOROOT_DEQUE
#if !defined(__wasm__)
#error "LithoRoot std headers are wasm32-only; native builds use their own C++ library"
#endif
#include <algorithm>
#include <compare>
#include <initializer_list>
#include <iterator>
#include <memory>
#include <stdexcept>
#include <utility>

namespace std {

template <class T, class A = allocator<T>> class deque;
namespace __lk {
template <class T> inline constexpr size_t dq_block = sizeof(T) < 32 ? 512 / sizeof(T) : 16;
template <class T, bool Const> class dq_iter {
  template <class, bool> friend class dq_iter;
  template <class, class> friend class std::deque;
  T* const* map_ = nullptr;  // map base
  size_t i_ = 0;             // absolute index from the map's first slot
 public:
  using iterator_category = random_access_iterator_tag;
  using value_type = T;
  using difference_type = ptrdiff_t;
  using pointer = conditional_t<Const, const T*, T*>;
  using reference = conditional_t<Const, const T&, T&>;
  dq_iter() = default;
  dq_iter(T* const* m, size_t i) noexcept : map_(m), i_(i) {}
  template <bool C = Const, class = enable_if_t<C>> dq_iter(const dq_iter<T, false>& o) noexcept : map_(o.map_), i_(o.i_) {}
  reference operator*() const noexcept { return map_[i_ / dq_block<T>][i_ % dq_block<T>]; }
  pointer operator->() const noexcept { return addressof(**this); }
  reference operator[](difference_type n) const noexcept { return *(*this + n); }
  dq_iter& operator++() noexcept { ++i_; return *this; }
  dq_iter operator++(int) noexcept { auto t = *this; ++i_; return t; }
  dq_iter& operator--() noexcept { --i_; return *this; }
  dq_iter operator--(int) noexcept { auto t = *this; --i_; return t; }
  dq_iter& operator+=(difference_type n) noexcept { i_ = size_t(difference_type(i_) + n); return *this; }
  dq_iter& operator-=(difference_type n) noexcept { i_ = size_t(difference_type(i_) - n); return *this; }
  friend dq_iter operator+(dq_iter a, difference_type n) noexcept { return a += n; }
  friend dq_iter operator+(difference_type n, dq_iter a) noexcept { return a += n; }
  friend dq_iter operator-(dq_iter a, difference_type n) noexcept { return a -= n; }
  friend difference_type operator-(const dq_iter& a, const dq_iter& b) noexcept { return difference_type(a.i_) - difference_type(b.i_); }
  friend bool operator==(const dq_iter& a, const dq_iter& b) noexcept { return a.i_ == b.i_; }
  friend auto operator<=>(const dq_iter& a, const dq_iter& b) noexcept { return a.i_ <=> b.i_; }
};
}  // namespace __lk

template <class T, class A>
class deque {
  static constexpr size_t B = __lk::dq_block<T>;
 public:
  using value_type = T;
  using allocator_type = A;
  using size_type = size_t;
  using difference_type = ptrdiff_t;
  using reference = T&;
  using const_reference = const T&;
  using iterator = __lk::dq_iter<T, false>;
  using const_iterator = __lk::dq_iter<T, true>;
  using reverse_iterator = std::reverse_iterator<iterator>;
  using const_reverse_iterator = std::reverse_iterator<const_iterator>;

  deque() = default;
  explicit deque(size_type n) { for (size_type i = 0; i < n; ++i) emplace_back(); }
  deque(size_type n, const T& v) { for (size_type i = 0; i < n; ++i) push_back(v); }
  template <class It, class = enable_if_t<!is_integral_v<It>>> deque(It f, It l) { for (; f != l; ++f) emplace_back(*f); }
  deque(initializer_list<T> il) : deque(il.begin(), il.end()) {}
  deque(const deque& o) : deque(o.begin(), o.end()) {}
  deque(deque&& o) noexcept : map_(o.map_), mcap_(o.mcap_), b_(o.b_), e_(o.e_) { o.map_ = nullptr; o.mcap_ = o.b_ = o.e_ = 0; }
  ~deque() { clear(); for (size_t i = 0; i < mcap_; ++i) if (map_[i]) at_().deallocate(map_[i], B); ::operator delete(map_); }
  deque& operator=(const deque& o) { if (this != &o) { deque t(o); swap(t); } return *this; }
  deque& operator=(deque&& o) noexcept { if (this != &o) { deque t(std::move(o)); swap(t); } return *this; }
  void swap(deque& o) noexcept { std::swap(map_, o.map_); std::swap(mcap_, o.mcap_); std::swap(b_, o.b_); std::swap(e_, o.e_); }

  iterator begin() noexcept { return iterator(map_, b_); }
  const_iterator begin() const noexcept { return const_iterator(map_, b_); }
  iterator end() noexcept { return iterator(map_, e_); }
  const_iterator end() const noexcept { return const_iterator(map_, e_); }
  const_iterator cbegin() const noexcept { return begin(); }
  const_iterator cend() const noexcept { return end(); }
  reverse_iterator rbegin() noexcept { return reverse_iterator(end()); }
  const_reverse_iterator rbegin() const noexcept { return const_reverse_iterator(end()); }
  reverse_iterator rend() noexcept { return reverse_iterator(begin()); }
  const_reverse_iterator rend() const noexcept { return const_reverse_iterator(begin()); }
  [[nodiscard]] bool empty() const noexcept { return b_ == e_; }
  size_type size() const noexcept { return e_ - b_; }
  reference operator[](size_type i) noexcept { return slot(b_ + i); }
  const_reference operator[](size_type i) const noexcept { return slot(b_ + i); }
  reference at(size_type i) { if (i >= size()) __lk::throw_out_of_range("deque::at"); return slot(b_ + i); }
  const_reference at(size_type i) const { if (i >= size()) __lk::throw_out_of_range("deque::at"); return slot(b_ + i); }
  reference front() noexcept { return slot(b_); }
  const_reference front() const noexcept { return slot(b_); }
  reference back() noexcept { return slot(e_ - 1); }
  const_reference back() const noexcept { return slot(e_ - 1); }

  template <class... Args> reference emplace_back(Args&&... a) {
    if (e_ == mcap_ * B) grow(false);
    ensure_block(e_ / B);
    T* p = &slot(e_);
    std::construct_at(p, std::forward<Args>(a)...);
    ++e_;
    return *p;
  }
  template <class... Args> reference emplace_front(Args&&... a) {
    if (b_ == 0) grow(true);
    ensure_block((b_ - 1) / B);
    T* p = &slot(b_ - 1);
    std::construct_at(p, std::forward<Args>(a)...);
    --b_;
    return *p;
  }
  void push_back(const T& v) { emplace_back(v); }
  void push_back(T&& v) { emplace_back(std::move(v)); }
  void push_front(const T& v) { emplace_front(v); }
  void push_front(T&& v) { emplace_front(std::move(v)); }
  void pop_back() noexcept { std::destroy_at(&slot(--e_)); if (empty()) recentre(); }
  void pop_front() noexcept { std::destroy_at(&slot(b_++)); if (empty()) recentre(); }
  void clear() noexcept { while (b_ != e_) std::destroy_at(&slot(b_++)); recentre(); }
  void resize(size_type n) { while (size() > n) pop_back(); while (size() < n) emplace_back(); }
  void resize(size_type n, const T& v) { while (size() > n) pop_back(); while (size() < n) push_back(v); }
  iterator erase(const_iterator pos) { return erase(pos, pos + 1); }
  iterator erase(const_iterator f, const_iterator l) {
    const size_t i = f.i_ - b_, n = l.i_ - f.i_;
    if (n == 0) return begin() + difference_type(i);
    if (i < size() - i - n) {  // fewer elements in front: shift them back
      std::move_backward(begin(), begin() + difference_type(i), begin() + difference_type(i + n));
      for (size_t k = 0; k < n; ++k) pop_front();
    } else {
      std::move(begin() + difference_type(i + n), end(), begin() + difference_type(i));
      for (size_t k = 0; k < n; ++k) pop_back();
    }
    return begin() + difference_type(i);
  }
  template <class... Args> iterator emplace(const_iterator pos, Args&&... a) {
    const size_t i = pos.i_ - b_;
    T tmp(std::forward<Args>(a)...);
    if (i < size() / 2) {
      emplace_front(std::move(front()));
      std::move(begin() + 2, begin() + difference_type(i + 1), begin() + 1);
    } else {
      emplace_back(std::move(back()));
      std::move_backward(begin() + difference_type(i), end() - 2, end() - 1);
    }
    (*this)[i] = std::move(tmp);
    return begin() + difference_type(i);
  }
  iterator insert(const_iterator pos, const T& v) { return emplace(pos, v); }
  iterator insert(const_iterator pos, T&& v) { return emplace(pos, std::move(v)); }
  void shrink_to_fit() noexcept {}

 private:
  T** map_ = nullptr;
  size_t mcap_ = 0;  // map slots
  size_t b_ = 0, e_ = 0;  // absolute element indices [b_, e_)
  static A at_() noexcept { return A(); }
  T& slot(size_t i) const noexcept { return map_[i / B][i % B]; }
  void ensure_block(size_t bi) { if (!map_[bi]) map_[bi] = at_().allocate(B); }
  /* Double the map; existing blocks move to the middle so both ends have room. */
  void grow(bool front) {
    const size_t ncap = mcap_ ? mcap_ * 2 : 8;
    T** nm = static_cast<T**>(::operator new(ncap * sizeof(T*)));
    for (size_t i = 0; i < ncap; ++i) nm[i] = nullptr;
    const size_t shift = front ? ncap - mcap_ - (mcap_ ? 0 : ncap / 2) : (mcap_ ? 0 : ncap / 2);
    for (size_t i = 0; i < mcap_; ++i) nm[i + shift] = map_[i];
    ::operator delete(map_);
    map_ = nm; mcap_ = ncap;
    b_ += shift * B; e_ += shift * B;
  }
  void recentre() noexcept { if (mcap_) { b_ = e_ = (mcap_ / 2) * B; } else b_ = e_ = 0; }
};

template <class T, class A> bool operator==(const deque<T, A>& a, const deque<T, A>& b) { return a.size() == b.size() && std::equal(a.begin(), a.end(), b.begin()); }
template <class T, class A> void swap(deque<T, A>& a, deque<T, A>& b) noexcept { a.swap(b); }
template <class T, class A, class P> size_t erase_if(deque<T, A>& d, P p) {
  auto it = std::remove_if(d.begin(), d.end(), p); size_t n = size_t(d.end() - it); d.erase(it, d.end()); return n;
}
template <class T, class A, class U> size_t erase(deque<T, A>& d, const U& v) {
  return std::erase_if(d, [&](const T& x) { return x == v; });
}

}  // namespace std
#endif
