/* cstddef ... the LithoLibC++ <cstddef> header, added by the
 * toolchain piece.
 *
 * The C++ sources of LithoRoot (LithoAbi, new_delete.cc) include
 * the C++ wrapper headers <cstddef>, <cstdint> and <cstring>; on
 * the host gates those resolved to the host C++ library's, but the
 * wasm sysroot is ours end to end, so the wrappers live here. Each
 * is the standard shape and nothing more: pull in the C header
 * (ours, or the compiler's own for <stddef.h>) and lift the names
 * into namespace std. The surface is the one the sources use,
 * stated in docs/TOOLCHAIN.md.
 */
#ifndef LITHOLIBC_CSTDDEF_H
#define LITHOLIBC_CSTDDEF_H

#include <stddef.h>

namespace std {

using ::size_t;
using ::ptrdiff_t;

typedef decltype(nullptr) nullptr_t;
using ::max_align_t;

/* S2: std::byte (C++17), with the standard operator set. */
enum class byte : unsigned char {};
template <class I> constexpr I to_integer(byte b) noexcept { return I(b); }
constexpr byte operator|(byte l, byte r) noexcept { return byte((unsigned char)l | (unsigned char)r); }
constexpr byte operator&(byte l, byte r) noexcept { return byte((unsigned char)l & (unsigned char)r); }
constexpr byte operator^(byte l, byte r) noexcept { return byte((unsigned char)l ^ (unsigned char)r); }
constexpr byte operator~(byte b) noexcept { return byte(~(unsigned char)b); }
constexpr byte& operator|=(byte& l, byte r) noexcept { return l = l | r; }
constexpr byte& operator&=(byte& l, byte r) noexcept { return l = l & r; }
constexpr byte& operator^=(byte& l, byte r) noexcept { return l = l ^ r; }
template <class I> constexpr byte operator<<(byte b, I s) noexcept { return byte((unsigned char)((unsigned)b << s)); }
template <class I> constexpr byte operator>>(byte b, I s) noexcept { return byte((unsigned char)((unsigned)b >> s)); }
template <class I> constexpr byte& operator<<=(byte& b, I s) noexcept { return b = b << s; }
template <class I> constexpr byte& operator>>=(byte& b, I s) noexcept { return b = b >> s; }

} /* namespace std */

#endif /* LITHOLIBC_CSTDDEF_H */
